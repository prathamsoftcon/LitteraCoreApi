                    Dim mailsubject As String = ""
                    Dim mailtext As String = ""

                    Dim es As New EmailTemplate
                    es = dm.Get_EMAIL_TEMPLATE("CHANGEPASSWORD")
                    mailsubject = es.subject
                    mailtext = es.text.Replace("(#password#)", plainpwd)


                    System.Web.Hosting.HostingEnvironment.QueueBackgroundWorkItem(Function(cancellationToke)
                                                                                      dm.SendMail_With_XML_BACKGROUND(mailid, mailsubject, mailtext, Displayname, ismailrequired, emailsetting)

                                                                                  End Function)
                End If

            End If
        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - TRG_RESET_PASSWORD " + sqlex.Message)
            Try
