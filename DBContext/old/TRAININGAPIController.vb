    Function UserValidate_For_Mobile_Login(ByVal Domain As String, ByVal IsOnline As Boolean, ByVal loginattempt As String, ByVal username As String) As Boolean
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")

        Try
            Dim dtuserdetails As New DataTable

            Dim cnn As SqlConnection = dm.Get_Connection_String(Domain, IsOnline)
            cnn.Open()
            Dim cmd As New SqlCommand("[YUser].[UserValidate]", cnn)
            cmd.CommandType = Data.CommandType.StoredProcedure
            cmd.Parameters.AddWithValue("username", username)
            'cmd.Parameters.AddWithValue("password", Encrypts(Me.TxtPassword.Text.ToString()))
            'commented due to we have to not send any password to the procedure
            cmd.Parameters.AddWithValue("password", Nothing)
            cmd.Parameters.AddWithValue("loginattempts", loginattempt)
            'Extra Code to check & set User Type
            Dim da As SqlDataAdapter = New SqlDataAdapter(cmd)
            da.Fill(dtuserdetails)

            Dim dReader As Data.SqlClient.SqlDataReader = cmd.ExecuteReader()



            '***********************
            Dim Higher_user_type As String = dm.Get_Higher_Authority_To_Set_Data(dtuserdetails)
            While dReader.Read
                'Extra Code to check & set User Type
                If (dReader("usertype").ToString <> Higher_user_type) Then
                    Continue While
                End If
                '*****************************


                objlogininfo.mobileno = dReader("MobileNo").ToString
                objlogininfo.usertype = dReader("usertype").ToString


                objlogininfo.createdby = dReader("UserID").ToString
                objlogininfo.formroleid = dReader("FormRoleID").ToString
                objlogininfo.ledgerroleid = dReader("LedgerRoleID").ToString
                objlogininfo.agencyroleid = dReader("AgencyRoleId").ToString
                objlogininfo.emptypeid = dReader("AgencyTypeId").ToString
                objlogininfo.schemeroleid = dReader("SchemeRoleId").ToString

                objlogininfo.username = username
                If Not dReader.IsDBNull(dReader.GetOrdinal("CategoryRoleId")) Then
                    objlogininfo.categoryroleid = dReader("CategoryRoleId")
                End If
                If Not dReader.IsDBNull(dReader.GetOrdinal("EmployeeDesignationId")) Then
                    objlogininfo.employeedesignationid = dReader("EmployeeDesignationId").ToString
                End If

                If Not dReader.IsDBNull(dReader.GetOrdinal("EmployeeDivisionId")) Then
                    objlogininfo.employeedivisionid = dReader("EmployeeDivisionId").ToString
                End If

                If Not dReader.IsDBNull(dReader.GetOrdinal("EmployeeDepartmentId")) Then
                    objlogininfo.employeedepartmentid = dReader("EmployeeDepartmentId").ToString
                End If

                If Not dReader("EmployeeId").Equals(DBNull.Value) Then
                    objlogininfo.semployeeid = dReader("EmployeeId").ToString
                End If
                objlogininfo.hrrights = dReader("HR_Rights").ToString

            End While
            cmd.Dispose()
            cnn.Close()
        Catch ex As Exception
            logger.Error("TrainingAPI - UserValidate_For_Mobile_Login " + ex.Message)
        End Try
        Return True
    End Function
