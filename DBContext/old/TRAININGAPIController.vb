                            imagefile.Flush()
                        End Using
                        dtParam.Rows(i)(ImageParam) = Folder_Name + "/" + imagename1 + ""
                    End If
                Next




                '
            End If
            Dim dtReturnstr As New DataTable
            If dm.Save_Common_Data(Domain, IsOnline, ProcedureName, dtParam, dtXMLparam, XMLName, CreatedOnParameter) = True Then
