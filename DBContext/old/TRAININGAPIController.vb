            Return serializer1.Serialize(rows)
        End If

        Try
            Dim OTPCode As String = ""
            If pvalue.Length < 8 Then
                Throw New Exception("Password Length Should Be Minimum 8 Character.")
            End If
            pvalue = (YEncryptDecryptData.YEncryptDecryptData.Encrypt(pvalue, True))
            oldpwd = (YEncryptDecryptData.YEncryptDecryptData.Encrypt(oldpwd, True))
            Dim dtpwddetail As DataTable = dm.Get_User_Pwd_Details(Domain, IsOnline, username)
            If dtpwddetail.Rows.Count > 0 Then
                If oldpwd <> dtpwddetail.Rows(0)("password") Then
                    row = New Dictionary(Of String, Object)()
                    row.Add("status", "Error")
                    row.Add("msg", "Old Password not match.")
                    rows.Add(row)
                    Dim serializer2 As New JavaScriptSerializer
                    Return serializer2.Serialize(rows)
