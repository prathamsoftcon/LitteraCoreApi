            'Next
            Dim addedTrgIds As New HashSet(Of String)()


            For i = 0 To dtinfographic.Rows.Count - 1
                Dim trgId As String = dtinfographic.Rows(i)("trgid").ToString()

                '************** Check if the row is already added
                If addedTrgIds.Contains(trgId) Then
                    Continue For
                End If

                '*********** Filter and sum sessions
                Dim totalSession As Integer = 0
                Dim completedSession As Integer = 0
                For Each row1 As DataRow In dtinfographic.Select("trgid='" & trgId & "'")
                    If Not String.IsNullOrEmpty(row1("no_of_session").ToString()) Then
                        totalSession += Convert.ToInt16(row1("no_of_session"))
                    End If
                    If Not String.IsNullOrEmpty(row1("no_of_session_completed").ToString()) Then
                        completedSession += Convert.ToInt16(row1("no_of_session_completed"))
                    End If
                Next

                '*********** Get the number of unique faculty for this training
                Dim noOfFaculty As Integer = dtfaculty.Select("trainingid='" & trgId & "'").Distinct().Count(Function(f) f("ttttt_facultyid") IsNot DBNull.Value)

                '*********** Get completion percentage
                Dim completionPercentage As Decimal = Get_Trg_Session_Completion_Percentage(dtcompletionpercentage, trgId, usertype, userid, fromdt, todt)

                '*********** Append the results to StringBuilder
                sbinfographic.AppendFormat("{0}*{1}*{2}*{3}*{4}*{5}*{6}#",
                                trgId, totalSession, completedSession, "",
                                noOfFaculty, dtinfographic.Rows(i)("total_session_time").ToString(), completionPercentage)

                '*********** Add the trgId to the HashSet to track it
                addedTrgIds.Add(trgId)
            Next

