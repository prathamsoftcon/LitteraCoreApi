            Next

            'New Condition add to sort week in asc order
            dtweekdetail.DefaultView.Sort = "weekcount asc"
            dtweekdetail = dtweekdetail.DefaultView.ToTable
            For i = 0 To dtweekdetail.Rows.Count - 1
                HF_TRG_WEEK_DETAILS = HF_TRG_WEEK_DETAILS + dtweekdetail.Rows(i)("weekcount").ToString + "*" + dtweekdetail.Rows(i)("week").ToString + "*" + dtweekdetail.Rows(i)("daycount").ToString + "*" + dtweekdetail.Rows(i)("datevalue").ToString + "*" + dtweekdetail.Rows(i)("isenable").ToString + "#"
            Next


            Dim dtdistinctweek As DataTable = dtweekdetail.DefaultView.ToTable(True, "weekcount")
            dtdistinctweek.Columns.Add("mindate")
            dtdistinctweek.Columns.Add("maxdate")


            For i = 0 To dtdistinctweek.Rows.Count - 1
                dtweekdetail.DefaultView.RowFilter = "weekcount='" + dtdistinctweek.Rows(i)("weekcount").ToString + "'"
                Dim dtfilteredweekdata = dtweekdetail.DefaultView.ToTable
                dtfilteredweekdata.DefaultView.Sort = "daycount asc"
                dtfilteredweekdata = dtfilteredweekdata.DefaultView.ToTable
                dtdistinctweek.Rows(i)("mindate") = dtfilteredweekdata.Rows(0)("datevalue").ToString
                dtdistinctweek.Rows(i)("maxdate") = dtfilteredweekdata.Rows(dtfilteredweekdata.Rows.Count - 1)("datevalue").ToString

                HF_TRG_WEEKS = HF_TRG_WEEKS + dtdistinctweek.Rows(i)("weekcount").ToString + "*" + dtfilteredweekdata.Rows(0)("datevalue").ToString + "*" + dtfilteredweekdata.Rows(dtfilteredweekdata.Rows.Count - 1)("datevalue").ToString + "#"
            Next



            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            row.Add("HF_TRGID", HF_TRGID)
            row.Add("HF_TRGDetail", HF_TRGDetail)
            row.Add("HF_TRG_WEEKS", HF_TRG_WEEKS)
            row.Add("HF_TRG_WEEK_DETAILS", HF_TRG_WEEK_DETAILS)
            rows.Add(row)

            '****************Workarround to manage joing session
            dtTableData.Columns.Add("jointfaculty")
            For i = 0 To dtTableData.Rows.Count - 1
                If dtTableData.Rows(i)("ttttt_is_joint_session").ToString = "1" Then
                    dtTableData.DefaultView.RowFilter = "ttttt_session_id='" + dtTableData.Rows(i)("ttttt_session_id").ToString + "'"
                    Dim dtfileterfac As DataTable = dtTableData.DefaultView.ToTable
                    Dim facstr As String = ""
                    For j = 0 To dtfileterfac.Rows.Count - 1
                        If dtfileterfac.Rows(j)("tttttf_status") <> "9" Then
                            facstr = facstr + dtfileterfac.Rows(j)("ttttt_facultyid").ToString + ","
                        End If

                    Next
                    If facstr <> "" Then
                        dtTableData.Rows(i)("jointfaculty") = facstr.Substring(0, facstr.Length - 1)
                    End If


                    For j = 0 To dtTableData.Rows.Count - 1
                        If dtTableData.Rows(j)("ttttt_session_id").ToString.ToUpper = dtTableData.Rows(i)("ttttt_session_id").ToString.ToUpper Then
                            If facstr <> "" Then
                                dtTableData.Rows(j)("jointfaculty") = facstr.Substring(0, facstr.Length - 1)
                            End If

                            dtTableData.Rows(j)("ttttt_is_joint_session") = "1"
                        End If
                    Next


                End If
            Next


            '*********************

            If dtTableData.Rows.Count > 0 Then
                For i = 0 To dtTableData.Rows.Count - 1
                    row = New Dictionary(Of String, Object)()
                    For j = 0 To dtTableData.Columns.Count - 1
                        If dtTableData.Columns(j).ColumnName.ToString().ToUpper() = "TTTTT_SESSION_DURATION" Then
                            Dim durationmin As String
                            If dtTableData.Rows(i)("ttttt_session_duration_type").ToString() = "2" Then 'Hour
                                durationmin = (CInt(dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString()) / 60).ToString
                            ElseIf dtTableData.Rows(i)("ttttt_session_duration_type").ToString() = "3" Then 'Days
                                durationmin = (CInt(dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString()) / 1440).ToString
                            Else
                                durationmin = dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString()
                            End If
                            row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), durationmin)
                        Else
                            row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString())
                        End If
                    Next
                    rows.Add(row)
                Next
            End If
        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - GET_TRG_SESSION_DETAILS" + sqlex.Message)
            Try
