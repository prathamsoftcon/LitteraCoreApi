    Public Function GET_TRAINING_SESSION_DATE_TYPE(ByVal Domain As String, ByVal IsOnline As String, ByVal trainingid As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim sb As New StringBuilder
        Dim dtTableData As New DataTable
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing
        Dim trgdays As Integer = 0
        Try
            Dim dt As New DataTable
            Dim is_Session_Day_Req As String = "0"
            dt = dm.Get_TRG_DETAIL(Domain, IsOnline, trainingid).Tables(0)
            If dt.Rows.Count > 0 Then
                If dt.Rows(0)("trg_type").ToString() = "2" Then
                    is_Session_Day_Req = "1"
                Else
                    is_Session_Day_Req = "0"
                End If
                Dim startdate = CDate(dt.Rows(0)("T_StartDate").ToString())
                Dim enddate = CDate(dt.Rows(0)("T_ClosingDate").ToString())
                Dim duration As String = dt.Rows(0)("Duration").ToString()
                Dim durationtypedays As Int16
                Dim totaltrainingdays As Int16 = 0
                If dt.Rows(0)("DurationType").ToString().ToUpper() = "DAYS" Then
                    durationtypedays = 1
                ElseIf dt.Rows(0)("DurationType").ToString().ToUpper() = "MONTH" Then
                    durationtypedays = 30
                ElseIf dt.Rows(0)("DurationType").ToString().ToUpper() = "WEEKS" Then
                    durationtypedays = 7
                End If
                totaltrainingdays = Convert.ToInt32(dt.Rows(0)("Duration").ToString()) * durationtypedays



                trgdays = totaltrainingdays
            End If





            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            row.Add("is_Session_Day_Req", is_Session_Day_Req)
            row.Add("Trg_Dates", trgdays)
            rows.Add(row)

        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - RCVP_CHECK_REGISTERED_USER" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
