                Dim subjectknowledge As String = ""

                'For j = 0 To dtfilter.Rows.Count - 1


                '    If dtfilter.Rows(j)("SubSpecilization").ToString <> "" Then
                '        subjectknowledge = subjectknowledge + dtfilter.Rows(j)("SubSpecilization").ToString + "-" + dtfilter.Rows(j)("TopicExperience").ToString + ","
                '    End If



                'Next
                'If subjectknowledge <> "" Then
                '    dtTableData.Rows(i)("SubSpecilization") = subjectknowledge.Substring(0, subjectknowledge.Length - 1)
                'Else
                '    dtTableData.Rows(i)("SubSpecilization") = subjectknowledge
                'End If


                Dim dtdistdata As New DataTable
                dtfulldata = dsdata.Tables(TableIndex)
                dtfulldata.DefaultView.RowFilter = String.Empty

                dtfulldata.DefaultView.RowFilter = "GuestFacultyId='" + dtTableData.Rows(i)("guestfacultyid").ToString + "' and agencystatus <> '9'"
                dtfulldata = dtfulldata.DefaultView.ToTable
                dtdistdata = dtfulldata.DefaultView.ToTable("GuestFacultyId", True, "tyaam_typeid")
                Dim type As String = ""
                For k = 0 To dtdistdata.Rows.Count - 1
                    If dtdistdata.Rows(k)("tyaam_typeid").ToString() = "00054" Then
                        type = type + "Faculty - "
                    ElseIf dtdistdata.Rows(k)("tyaam_typeid").ToString() = "00066" Then
                        type = type + "Mentor - "
                    ElseIf dtdistdata.Rows(k)("tyaam_typeid").ToString() = "00067" Then
                        type = type + "Guest Speaker - "
                    End If
                Next
                If type <> "" Then
                    type = type.Substring(0, type.Length - 2)
                End If




                If dtTableData.Rows(i)("tyaam_val").ToString <> "" Then
                    Dim xmlstr As String = dtTableData.Rows(i)("tyaam_val").ToString
                    Dim dS_specific_xml_data As New DataSet
                    Dim dt_specific_xml_data As New DataTable
                    Dim sr As New StringReader(xmlstr)
                    dS_specific_xml_data.ReadXml(sr)
                    dt_specific_xml_data = dS_specific_xml_data.Tables(0)

                    'Extra code to get course details from additional info
                    Dim dtcoursedetails As New DataTable
                    If dS_specific_xml_data.Tables.Contains("DETAILS") Then
                        dtcoursedetails = dS_specific_xml_data.Tables("DETAILS")

                    End If

                    If dtcoursedetails.Rows.Count > 0 Then
                        If dtcoursedetails.Columns.Contains("SUB_SPECILIZATION") And dtcoursedetails.Columns.Contains("TOPICEXPERIENCE") Then
                            For k = 0 To dtcoursedetails.Rows.Count - 1
                                subjectknowledge = subjectknowledge + dtcoursedetails.Rows(k)("SUB_SPECILIZATION").ToString() + "-" + dtcoursedetails.Rows(k)("TOPICEXPERIENCE").ToString() + ","
                            Next
                        End If

                    End If

                    If subjectknowledge <> "" Then
                        dtTableData.Rows(i)("SubSpecilization") = subjectknowledge.Substring(0, subjectknowledge.Length - 1)
                    Else
                        dtTableData.Rows(i)("SubSpecilization") = subjectknowledge
                    End If



                    If dt_specific_xml_data.Columns.Contains("ISHONORARIUMPAYMENT") Then
                        dtTableData.Rows(i)("XISHONORARIUMPAYMENT") = dt_specific_xml_data.Rows(0)("ISHONORARIUMPAYMENT").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("CURRENTORGANISATION") Then
                        dtTableData.Rows(i)("XCURRENTORGANISATION") = dt_specific_xml_data.Rows(0)("CURRENTORGANISATION").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("DESIGNATION") Then
                        dtTableData.Rows(i)("XDESIGNATION") = dt_specific_xml_data.Rows(0)("DESIGNATION").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("BANK") Then
                        dtTableData.Rows(i)("XBANK") = dt_specific_xml_data.Rows(0)("BANK").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("BRANCH") Then
                        dtTableData.Rows(i)("XBRANCH") = dt_specific_xml_data.Rows(0)("BRANCH").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("IFSC") Then
                        dtTableData.Rows(i)("XIFSC") = dt_specific_xml_data.Rows(0)("IFSC").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("ACCOUNTNO") Then
                        dtTableData.Rows(i)("XACCOUNTNO") = dt_specific_xml_data.Rows(0)("ACCOUNTNO").ToString
                    End If
                End If




                dtTableData.Rows(i)("type") = type
                exitstingData.Add(dtTableData.Rows(i)("guestfacultyid").ToString)
            Next
            dtTableData.DefaultView.RowFilter = "Deletedrow is null"
            dtTableData = dtTableData.DefaultView.ToTable

            dtTableData.DefaultView.Sort = "GuestFacultyName"
            dtTableData = dtTableData.DefaultView.ToTable
            If dtTableData.Rows.Count > 0 Then
                For i = 0 To dtTableData.Rows.Count - 1
                    row = New Dictionary(Of String, Object)()
                    For j = 0 To dtTableData.Columns.Count - 1
                        row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString())
                    Next
                    Dim dtfilteragencydata As DataTable
                    dtTableData.DefaultView.RowFilter = "GuestFacultyId='" + dtTableData.Rows(i)("GuestFacultyId").ToString + "'"
                    dtfilteragencydata = dtTableData.DefaultView.ToTable
                    rows.Add(row)
                Next
            End If
        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Get_TRG_FAC_DIST_DATA" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
