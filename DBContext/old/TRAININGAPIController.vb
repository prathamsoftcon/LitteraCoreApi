                        TC_CONDUCT += 1
                        SCP_CONDUCT += Val(.Item("noofparticipant_REG").ToString)
                        TCP_CONDUCT += Val(.Item("noofparticipant_REG").ToString)
                        CONDUCT_STATUS_TEXT = "CONDUCTED"
                    ElseIf .Item("TrainingStatus").ToString = "2" Then 'POSTPONED 
