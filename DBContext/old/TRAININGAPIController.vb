    Private Function GetinstrumentXML(ByVal hf_instrument As String, ByVal finalamt As String) As String
        Dim INSTRUMENTXML As String = Nothing
        Dim dtINSTRUMENTXML As New DataTable
        dtINSTRUMENTXML.Columns.Add("ROWNO")
        dtINSTRUMENTXML.Columns.Add("CHEQUENO")
        dtINSTRUMENTXML.Columns.Add("CHEQUEDATE")
        dtINSTRUMENTXML.Columns.Add("CHEQUEAMOUNT")
        dtINSTRUMENTXML.Columns.Add("BANKNAME")

        dtINSTRUMENTXML.Columns.Add("INSTRUMENTID")

        Dim INSTRUMENTID As String = Nothing



        If hf_instrument <> "" Then
            Dim BANKNAME As String = Nothing
            Dim spt_hf_instrument() As String = hf_instrument.Split("#")
            'Bankid*BankName*checkno*chequedate*amt#

            For index As Integer = 0 To spt_hf_instrument.Length - 1
                Dim sptFields() As String = spt_hf_instrument(index).Split("*")
                If sptFields(1) = "" OrElse sptFields(1) = "&nbsp;" Then
                    BANKNAME = ""
                Else
                    BANKNAME = sptFields(1)
                End If
                INSTRUMENTID = sptFields(0)

                dtINSTRUMENTXML.LoadDataRow(New Object() {index + 1,
                             sptFields(2).ToString,
                            General.Get_DB_Date(sptFields(3)).ToString("yyyy/MM/dd"),
                           Val(sptFields(4)),
                           BANKNAME, INSTRUMENTID}, False)

            Next
            'code added by rajesh sharma on 19-sep-2011 for insert the cash details in receipt_instrument Table
        Else
            Dim insrtumentid As String = CType(Session("dtbank"), DataTable).Rows(0).Item("hiddenbankid").ToString
            dtINSTRUMENTXML.LoadDataRow(New Object() {1, "", General.Get_DB_Date(Common.getDateTime.ToString("dd/MM/yyyy")).ToString("yyyy/MM/dd"),
                                Val(finalamt), "", insrtumentid}, False)

        End If

        If dtINSTRUMENTXML.Rows.Count > 0 Then
            Dim writer As New System.IO.StringWriter
            dtINSTRUMENTXML.TableName = "INSTRUMENTXML"
            dtINSTRUMENTXML.WriteXml(writer)
            INSTRUMENTXML = writer.ToString
        End If
        Return INSTRUMENTXML
    End Function
