    Public Function DerializeDataTable(ByVal json As String) As DataTable
        Dim dt As DataTable
        json = json.Replace("{'", "{""")
        json = json.Replace("'}", """}")


        json = json.Replace("':'", """:""")

        json = json.Replace("'", "\'")
        dt = JsonConvert.DeserializeObject(Of DataTable)(json)
        Return dt
    End Function
