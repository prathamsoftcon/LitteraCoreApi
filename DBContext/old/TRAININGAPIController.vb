    Public Function GetTableData(ByVal Domain As String, ByVal IsOnline As String, ByVal TableName As String, ByVal APIKEY As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim sb As New StringBuilder
#Disable Warning BC42024 ' Unused local variable: 'dsdata'.
        Dim dsdata As DataSet
#Enable Warning BC42024 ' Unused local variable: 'dsdata'.
        Dim dtTableData As New DataTable
