    Private Sub FillBillDetailTable1(TrainingId)
        dtBillDetail = Session("dtBillDetail")
        If dtBillDetail Is Nothing Then
            dtBillDetail = New DataTable
            Dim pCol1 As New DataColumn("Trainingid", GetType(String))
            Dim pCol2 As New DataColumn("Expid", GetType(String))
            dtBillDetail.Columns.Add(pCol1)
            dtBillDetail.Columns.Add(pCol2)
            dtBillDetail.PrimaryKey = New DataColumn() {pCol1, pCol2}
            dtBillDetail.Columns.Add("ExpidName")
            dtBillDetail.Columns.Add("Proposedamount")
            dtBillDetail.Columns.Add("ExtraCharge")
            dtBillDetail.Columns.Add("TotalAmount")
        End If

        dtEXP_Head = Session("dtEXP_Head")
        If (Not dtEXP_Head Is Nothing) AndAlso dtEXP_Head.Rows.Count > 0 Then
            dtEXP_Head.DefaultView.RowFilter = "Trainingid='" & TrainingId & "'"
            dtEXP_Head = dtEXP_Head.DefaultView.ToTable
            Dim sponsoramt As Decimal
            If dtEXP_Head.Rows.Count > 0 Then
                For index As Integer = 0 To dtEXP_Head.Rows.Count - 1
                    With dtEXP_Head.Rows(index)

                        If .IsNull("checkbilltraining") = True Then
                            sponsoramt = Val(.Item("T_amount").ToString)
                        Else
                            sponsoramt = 0
                        End If
                        dtBillDetail.LoadDataRow(New Object() { .Item("Trainingid").ToString,
                                  .Item("T_ExpHeadId").ToString,
                                 "",
                                  sponsoramt,
                                  0,
                                 0}, True)
                    End With
                Next
            End If
        End If
        dtEXP_Head.DefaultView.RowFilter = Nothing
        dtEXP_Head = Session("dtBillDetail")
        Session("dtBillDetail") = dtBillDetail
    End Sub

