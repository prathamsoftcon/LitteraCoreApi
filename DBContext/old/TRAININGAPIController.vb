    Public Function Num2WordConverter(ByVal Number As String, ByVal language As String) As Object

        Dim Words As String = Nothing
        Dim Length As Integer = 0
        Dim Whole As Decimal = Nothing
        Dim Fraction As Decimal = Nothing

        'Whole = Math.Floor(Convert.ToDecimal(Number));

        Whole = Math.Floor(Convert.ToDecimal(Number))
        Fraction = (Convert.ToDecimal(Number) - Whole) + Convert.ToDecimal("000")

        Length = Whole.ToString().Length

        'coz if the fraction part is just 0 it will generate error in substring

        'if (Fraction.ToString().Length >= 4)
        If Fraction.ToString().Length >= 4 Then
            Fraction = Convert.ToInt32(Fraction.ToString().Substring(2, 2))
        End If

        'For 10 to 99 Crores
        If Length = 9 Then
            If language = "0" Then
                Words = MakeWord(Convert.ToInt32(Whole.ToString().Substring(0, 2)), language) + "करोड "

                If Convert.ToInt32(Whole.ToString().Substring(2, 2)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(2, 2)), language) + " लाख "
                End If


                If Convert.ToInt32(Whole.ToString().Substring(4, 2)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(4, 2)), language) + " हजार "
                End If


                If Convert.ToInt32(Whole.ToString().Substring(6, 1)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(6, 1)), language) + " सौ "
                End If

                If Convert.ToInt32(Whole.ToString().Substring(7, 2)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(7, 2)), language)
                End If





                Words += " रु  तथा  " + MakeWord(Convert.ToInt32(Fraction), language) + " पैसे "
            Else
                Words = MakeWord(Convert.ToInt32(Whole.ToString().Substring(0, 2)), language) + " Crores"

                If Convert.ToInt32(Whole.ToString().Substring(2, 2)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(2, 2)), language) + " Lacs"
                End If


                If Convert.ToInt32(Whole.ToString().Substring(4, 2)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(4, 2)), language) + " Thousand"
                End If


                If Convert.ToInt32(Whole.ToString().Substring(6, 1)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(6, 1)), language) + " Hundred"
                End If

                If Convert.ToInt32(Whole.ToString().Substring(7, 2)) <> 0 Then
                    Words += " " + MakeWord(Convert.ToInt32(Whole.ToString().Substring(7, 2)), language)
                End If





                Words += " Rupees  And " + MakeWord(Convert.ToInt32(Fraction), language) + " Paise Only."
            End If

        ElseIf Length = 8 Then
            If language = "0" Then
