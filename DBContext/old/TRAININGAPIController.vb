                        TC_POSTPONED += 1
                        SCP_POSTPONED += Val(.Item("noofparticipant").ToString)
                        TCP_POSTPONED += Val(.Item("noofparticipant").ToString)
                        POSTPONED_STATUS_TEXT = "POSTPONED"
                    ElseIf .Item("TrainingStatus").ToString = "3" Then 'CANCELLED
                        SC_CANCELLED += 1
                        TC_CANCELLED += 1
                        SCP_CANCELLED += 0 'Val(.Item("noofparticipant").ToString)
                        TCP_CANCELLED += 0 'Val(.Item("noofparticipant").ToString)
                        CANCELLED_STATUS_TEXT = "CANCELED"
                    End If

                    ''''''''''''''''
                    SC_PROPOSED += 1
                    TC_PROPOSED += 1
                    SCP_PROPOSED += Val(.Item("noofparticipant").ToString)
                    TCP_PROPOSED += Val(.Item("noofparticipant").ToString)
                    '''''''''''''''''''''''''

                End With
            Next

            'PROPOSED
            sbTrainingDetails.Append("<td align='Center' >" & SC_PROPOSED & "</td>")
            sbTrainingDetails.Append("<td align='Center' >" & SCP_PROPOSED & "</td>")
            'CONDUCT
            sbTrainingDetails.Append("<td align='Center' >" & SC_CONDUCT & "</td>")
            sbTrainingDetails.Append("<td align='Center' >" & SCP_CONDUCT & "</td>")
            'POSTPONED
            sbTrainingDetails.Append("<td align='Center' >" & SC_POSTPONED & "</td>")
            sbTrainingDetails.Append("<td align='Center' >" & SCP_POSTPONED & "</td>")
            ' CANCEL
            sbTrainingDetails.Append("<td align='Center' >" & SC_CANCELLED & "</td>")
            sbTrainingDetails.Append("<td align='Center' >" & SCP_CANCELLED & "</td>")
            ' BALANCE
            sbTrainingDetails.Append("<td align='Center' >" & SC_BALANCE & "</td>")
            sbTrainingDetails.Append("<td align='Center' >" & SCP_BALANCE & "</td>")

            sbTrainingDetails.Append("</tr>")
            SC_PROPOSED = 0
            SC_POSTPONED = 0
            SC_CONDUCT = 0
            SC_CANCELLED = 0
            SC_BALANCE = 0
            SCP_PROPOSED = 0
            SCP_POSTPONED = 0
            SCP_CONDUCT = 0
            SCP_CANCELLED = 0
            SCP_BALANCE = 0
        Next
        'GRAND TOTAL
        sbTrainingDetails.Append("<tr style= 'font-size:14px;font-family: Verdana;'>")
        'Edit by uttam (11/12/12)Task No: (1179)
        If Session("Choice") = 1 Then
            sbTrainingDetails.Append("<td align='Center' colspan='2' > TOTAL</td>")
        Else
            sbTrainingDetails.Append("<td align='Center' colspan='2' >कुल योग</td>")
