    Public Function GetFinancialYear() As DataTable
        Dim dtfinYear As New DataTable
        dtfinYear.Columns.Add("YearText")
        dtfinYear.Columns.Add("YearValue")
        Dim year As Integer = Now.Year
        Dim finyear As String
        For index As Integer = -12 To 5
            finyear = year + index & "-" & year + index + 1
            dtfinYear.LoadDataRow(New Object() {finyear, finyear}, False)
        Next
        Return dtfinYear
    End Function


