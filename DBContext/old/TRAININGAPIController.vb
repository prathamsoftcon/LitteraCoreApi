    Public Function fillparticipants(ByVal ds As DataSet, ByVal fdate As String, ByVal tdate As String, ByVal newstr As String) As DataTable
        Dim dtParticipants As DataTable = ds.Tables(1)
        Dim dtfinal As DataTable

        Dim t_days As Integer
        Dim chkdate As Date
        Dim chktodate As Date
        If ds.Tables.Count > 0 Then

            Dim dtTrainee As New DataTable
            dtTrainee.Columns.Add("Participantid")
            dtTrainee.Columns.Add("ParticipantName")

            Dim dr As DataRow

            dtParticipants.DefaultView.Sort = "TrainingWiseRowNumber"
            dtParticipants = dtParticipants.DefaultView.ToTable()
            For index As Integer = 0 To dtParticipants.Rows.Count - 1
                With dtParticipants.Rows(index)
                    dr = dtTrainee.NewRow
                    dr.Item("Participantid") = .Item("Participantid").ToString
                    If Me.Session("Choice") = 1 Then
                        dr.Item("ParticipantName") = .Item("ParticipantName").ToString
                    Else
                        If dtParticipants.Rows(index).Item("HParticipantName").ToString.ToUpper = "" Then
                            dr.Item("ParticipantName") = .Item("ParticipantName").ToString
                        Else
                            dr.Item("ParticipantName") = .Item("HParticipantName").ToString
                        End If
                    End If
                    'dr.Item("onleave") = .Item("onleave").ToString

                    dtTrainee.Rows.Add(dr)
                End With
            Next
            dtfinal = dtTrainee

            If fdate = "" Then
                chkdate = CDate(dtParticipants.Rows(0).Item("T_startdate").ToString)
            Else
                chkdate = Get_DB_Date(fdate)
            End If
            If tdate = "" Then
                chktodate = CDate(dtParticipants.Rows(0).Item("T_ClosingDate").ToString)
            Else
                chktodate = Get_DB_Date(tdate)
            End If
            t_days = DateDiff(DateInterval.Day, chkdate, chktodate)
            If t_days > 6 Then
                t_days = 6
            End If
        End If
        Dim pre, post As String
        For i = 0 To t_days
#Disable Warning BC42104 ' Variable 'dtfinal' is used before it has been assigned a value. A null reference exception could result at runtime.
            pre = dtfinal.Columns.Add(chkdate.AddDays(i).ToString("dd/MM/yyyy") + "_PRE").ToString()
#Enable Warning BC42104 ' Variable 'dtfinal' is used before it has been assigned a value. A null reference exception could result at runtime.
            post = dtfinal.Columns.Add(chkdate.AddDays(i).ToString("dd/MM/yyyy") + "_POST").ToString()
            post = dtfinal.Columns.Add(chkdate.AddDays(i).ToString("dd/MM/yyyy") + "_onLeave").ToString()
            newstr = newstr + pre + "*" + post + "*" + "#"
        Next

        Return dtfinal
    End Function
