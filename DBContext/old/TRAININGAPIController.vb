    Public Function Get_TRG_DETAIL_PRINT_DATA(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal TableIndex As Int16, ByVal ImageParam As String, ByVal APIKEY As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim sb As New StringBuilder
        Dim dsdata As DataSet
        Dim dtTableData As New DataTable
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If


        Try
            Dim dtColXML As DataTable
            If Parameters IsNot Nothing Then
                dtColXML = DerializeDataTable(Parameters)
            End If
#Disable Warning BC42104 ' Variable 'dtColXML' is used before it has been assigned a value. A null reference exception could result at runtime.
            dsdata = dm.Get_Common_Data(Domain, IsOnline, ProcedureName, dtColXML)
#Enable Warning BC42104 ' Variable 'dtColXML' is used before it has been assigned a value. A null reference exception could result at runtime.
            dtTableData = dsdata.Tables(TableIndex)
            Dim dtsponsor As DataTable = dsdata.Tables(2)
            Dim dtexp As DataTable = dsdata.Tables(1)
            Dim feesperparticipant As Decimal = 0.00
            Dim discountpercent As Decimal = 0.00


            Dim sponsorname As String
            Dim hsponsorname As String
            Dim noofparticipant As Integer = 0
            Dim sponsoredamt As Integer = 0



            dtTableData.Columns.Add("SponsorName")
            dtTableData.Columns.Add("HSponsorName")
            dtTableData.Columns.Add("NoOfParticipant")
            dtTableData.Columns.Add("totalamt")

            For i = 0 To dtsponsor.Rows.Count - 1
                sponsorname = sponsorname + dtsponsor.Rows(i)("sponsorname").ToString + ","
                If dtsponsor.Rows(i)("hsponsorname").ToString <> "" Then
                    hsponsorname = hsponsorname + dtsponsor.Rows(i)("hsponsorname").ToString + ","
                Else
                    hsponsorname = hsponsorname + dtsponsor.Rows(i)("sponsorname").ToString + ","
                End If
                If dtsponsor.Rows(i)("DeptwiseNoofparticipant").ToString <> "" Then
                    noofparticipant = noofparticipant + CInt(dtsponsor.Rows(i)("DeptwiseNoofparticipant").ToString)
                End If

            Next

            For i = 0 To dtexp.Rows.Count - 1
                Dim qty As Decimal = 0.00
                Dim rate As Decimal = 0.00
                Dim amt As Decimal = 0.00
                If dtexp.Rows(i)("T_Quantity").ToString <> "" Then
                    qty = CDbl(dtexp.Rows(i)("T_Quantity").ToString)
                End If
                If dtexp.Rows(i)("T_Rate").ToString <> "" Then
                    rate = CDbl(dtexp.Rows(i)("T_Rate").ToString)
                End If
                amt = qty * rate
                sponsoredamt = sponsoredamt + CDbl(amt)


                'Calculate fees per participant
                If dtexp.Rows(i)("T_ExpHeadId").ToString.ToUpper <> "417119B3-18B6-43A1-8A52-064E99B6880E" Then
                    feesperparticipant = feesperparticipant + rate
                Else
                    If dtexp.Rows(i)("T_Rate").ToString <> "" Then
                        discountpercent = discountpercent + CDbl(dtexp.Rows(i)("T_Rate").ToString)
                    End If

                End If

            Next
            feesperparticipant = feesperparticipant - ((feesperparticipant * discountpercent)) / 100


            sponsorname = sponsorname.Substring(0, sponsorname.Length - 1)
            hsponsorname = hsponsorname.Substring(0, hsponsorname.Length - 1)

            For i = 0 To dtTableData.Rows.Count - 1
                dtTableData.Rows(i)("SponsorName") = sponsorname.ToString
                dtTableData.Rows(i)("HSponsorName") = hsponsorname.ToString
                dtTableData.Rows(i)("NoOfParticipant") = noofparticipant.ToString
                If dtTableData.Rows(i)("exptype").ToString <> "0" Then
                    dtTableData.Rows(i)("totalamt") = (CDbl(sponsoredamt) * CDbl(noofparticipant)).ToString
                Else
                    dtTableData.Rows(i)("totalamt") = sponsoredamt.ToString
                End If

            Next


            '**************Calculate Fees per participant
            dtTableData.Columns.Add("feesperparticipant")
            If dtTableData.Rows.Count > 0 Then
                Dim perpartamt As Decimal = 0.00
                If dtTableData.Rows(0)("Training_SponsorType").ToString = "4" Then
                    dtTableData.Rows(0)("feesperparticipant") = feesperparticipant
                End If
            End If

            '***********



            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)
            Dim dtreceivedamt As DataTable = dm.Get_Received_Amt(Domain, IsOnline)
            If dtTableData.Rows.Count > 0 Then
                For i = 0 To dtTableData.Rows.Count - 1
                    row = New Dictionary(Of String, Object)()
                    For j = 0 To dtTableData.Columns.Count - 1
                        row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString())
                    Next

                    Dim totalreceivedamt As String = Get_Trg_Received_Amt_For_Paid_Trg(dtreceivedamt, dtTableData.Rows(i)("TrainingId").ToString)
                    row.Add("totalreceivedamt", totalreceivedamt)
                    rows.Add(row)
                Next

            End If
        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Get_TRG_DETAIL_PRINT_DATA" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Get_TRG_DETAIL_PRINT_DATA" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - Get_TRG_DETAIL_PRINT_DATA" + exce.Message)
            'LblError.Text = exce.Message
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - Get_TRG_DETAIL_PRINT_DATA" + expe.Message)
            'LblError.Text = expe.Message.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
            logger.Error("TrainingAPI - Get_TRG_DETAIL_PRINT_DATA" + ex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message_Front_end(Domain, IsOnline, ex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Get_TRG_DETAIL_PRINT_DATA" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        End Try
        Dim serializer As New JavaScriptSerializer
        serializer.MaxJsonLength = Integer.MaxValue
        Return serializer.Serialize(rows)
