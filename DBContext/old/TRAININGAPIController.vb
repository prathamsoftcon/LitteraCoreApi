    Public Function RCVP_COLLECT_REG_RPT(ByVal Domain As String, ByVal IsOnline As String, ByVal FromDte As String, ByVal Todte As String, ByVal Schemeid As String, ByVal SponsId As String, ByVal IsCancelReceipt As String, ByVal Createdby As String, ByVal branchid As String, ByVal Language As String, ByVal APIKEY As String, ByVal Formroleid As String, ByVal userid As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
