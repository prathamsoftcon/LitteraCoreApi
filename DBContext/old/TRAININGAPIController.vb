                filtertype = CInt(SESSION_TYPE.Academic).ToString + "," + CInt(SESSION_TYPE.Tour).ToString + "," + CInt(SESSION_TYPE.Group_Discussion).ToString + "," + CInt(SESSION_TYPE.Presentation).ToString + "," + CInt(SESSION_TYPE.PT).ToString + "," + CInt(SESSION_TYPE.SPORT).ToString + "," + CInt(SESSION_TYPE.Practical).ToString
            Case ACTIVITY_TYPE.ASSIGN_TEST
                filtertype = CInt(SESSION_TYPE.Academic).ToString + "," + CInt(SESSION_TYPE.Test).ToString
            Case ACTIVITY_TYPE.FEEDBACK
                filtertype = CInt(SESSION_TYPE.Academic).ToString + "," + CInt(SESSION_TYPE.Tour).ToString + "," + CInt(SESSION_TYPE.Group_Discussion).ToString + "," + CInt(SESSION_TYPE.Presentation).ToString + "," + CInt(SESSION_TYPE.PT).ToString + "," + CInt(SESSION_TYPE.SPORT).ToString
