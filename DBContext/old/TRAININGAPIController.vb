            dtTrainingStatus_DTL = dtTrainingStatus_DTL.DefaultView.ToTable
        End If


        If sponsortypeid = "1" Then
            dtTrainingStatus_DTL.DefaultView.RowFilter = "Training_SponsorType=1"
