            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If
        Try
            Dim ds As New DataSet
            Dim temp As New DataTable
            'call for  get facluty and topic
            ds = dm.GetTrainingPlanDetails(Domain, IsOnline, TrainingCode, 0, 0)
            'gvFaculty.DataSource = Nothing
            'gvFaculty.DataBind()
            Dim dtFaculty As DataTable = ds.Tables(4)
            dtFaculty.DefaultView.RowFilter = "facultyid is not null"
            dtFaculty = dtFaculty.DefaultView.ToTable
            ' Below Line is commented on 6-APLR-2011 as per  modified req.
            ' dtFaculty.DefaultView.RowFilter = "ContentId <> '" & General.Intro_TopicID & "' and ContentId <> '" & General.Feedback_TopicID & "'"
            ' dtFaculty = dtFaculty.DefaultView.ToTable



            'add column for faculty grid
            Dim dr As DataRow
            temp.Columns.Add("sno")
            temp.Columns.Add("faculty")
            temp.Columns.Add("facultyid")
            temp.Columns.Add("subject")
            temp.Columns.Add("subjectid")
            'loop for fill faculty and topic
            For index As Integer = 0 To dtFaculty.Rows.Count - 1
                dr = temp.NewRow
                'set rows data 
                dr.Item("sno") = index + 1
                If Me.Session("Choice") = 1 Then
                    dr.Item("faculty") = dtFaculty.Rows(index).Item("hAgencyName").ToString
                Else
                    dr.Item("faculty") = dtFaculty.Rows(index).Item("AgencyName").ToString
                End If
                dr.Item("facultyid") = dtFaculty.Rows(index).Item("facultyid").ToString

                dr.Item("subject") = dtFaculty.Rows(index).Item("TopicContent").ToString
                dr.Item("subjectid") = dtFaculty.Rows(index).Item("ContentId").ToString
                temp.Rows.Add(dr)

                Dim li As New WebControls.ListItem
                li.Value = dtFaculty.Rows(index).Item("ContentId").ToString
                li.Text = dtFaculty.Rows(index).Item("TopicContent").ToString

                '  CheckBoxListContent.Items.Add(li)
            Next
            'set datatable into grid

#Disable Warning BC42024 ' Unused local variable: 'str'.
            Dim str As String
#Enable Warning BC42024 ' Unused local variable: 'str'.

            temp = temp.DefaultView.ToTable(True, "sno", "faculty", "facultyid", "subject", "subjectid")

            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)
            If temp.Rows.Count > 0 Then
                For i = 0 To temp.Rows.Count - 1
                    row = New Dictionary(Of String, Object)()
                    For j = 0 To temp.Columns.Count - 1
                        row.Add(temp.Columns(j).ColumnName.ToString().ToLower(), temp.Rows(i)(temp.Columns(j).ColumnName.ToString()).ToString())
                    Next
                    rows.Add(row)
                Next
            End If


        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - fillfacultygrid " + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - fillfacultygrid " + exce.Message)
            'LblError.Text = exce.Message
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - fillfacultygrid " + expe.Message)
            'LblError.Text = expe.Message.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
            logger.Error("TrainingAPI - fillfacultygrid " + ex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message_Front_end(Domain, IsOnline, ex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        End Try



        Dim serializer As New JavaScriptSerializer
        Return serializer.Serialize(rows)

    End Function

