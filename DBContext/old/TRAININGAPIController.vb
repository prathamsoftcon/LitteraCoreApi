    Public Function GET_UPCOMING_TRG(ByVal Domain As String, ByVal IsOnline As String, ByVal APIKEY As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim sb As New StringBuilder
        Dim dsdata As DataSet
        Dim dtTableData As New DataTable
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If


        Try
            Dim startdate As String
            Dim enddate As String
            startdate = DateTime.Now.AddMonths(-6).ToString("yyyy/MM/dd")
            enddate = DateTime.Now.AddMonths(6).ToString("yyyy/MM/dd")



            dtTableData = dm.GetTrainingCalender_LMS(Domain, IsOnline, startdate, enddate, Nothing, Nothing, "1")


            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)


            'Filter to Merge Same Sponsor Row Amount and Participant count
            dtTableData.Columns.Add("Deletedrow")
            Dim exitstingData As List(Of String) = New List(Of String)
            For i = 0 To dtTableData.Rows.Count - 1
                Dim dtfilter As New DataTable
                If (exitstingData.Contains(dtTableData.Rows(i)("TrainingId").ToString)) Then
                    dtTableData.Rows(i)("Deletedrow") = "1"
                    Continue For
                End If
                dtTableData.DefaultView.RowFilter = "TrainingId='" + dtTableData.Rows(i)("TrainingId").ToString + "'"
                dtfilter = dtTableData.DefaultView.ToTable
                Dim DueFees As String = "0"
                Dim ReceivedFees As String = "0"
                Dim NoOfParticipants As String = "0"
                Dim NoOfParticipants_Registered As String = "0"
                Dim attendance As String = "0"
                Dim sponsorname As String = ""
                Dim Hsponsorname As String = ""

                For j = 0 To dtfilter.Rows.Count - 1

                    If dtfilter.Rows(j)("DueFees").ToString <> "" Then
                        DueFees = (Convert.ToDecimal(DueFees) + Convert.ToDecimal(dtfilter.Rows(j)("DueFees").ToString)).ToString
                    End If
                    If dtfilter.Rows(j)("ReceivedFees").ToString <> "" Then
                        ReceivedFees = (Convert.ToDecimal(ReceivedFees) + Convert.ToDecimal(dtfilter.Rows(j)("ReceivedFees").ToString)).ToString
                    End If
                    If dtfilter.Rows(j)("NoOfParticipants").ToString <> "" Then
                        NoOfParticipants = (Convert.ToDecimal(NoOfParticipants) + Convert.ToDecimal(dtfilter.Rows(j)("NoOfParticipants").ToString)).ToString
                    End If
                    If dtfilter.Rows(j)("NoOfParticipants_Registered").ToString <> "" Then
                        NoOfParticipants_Registered = (Convert.ToDecimal(NoOfParticipants_Registered) + Convert.ToDecimal(dtfilter.Rows(j)("NoOfParticipants_Registered").ToString)).ToString
                    End If
                    If dtfilter.Rows(j)("attendance").ToString <> "" Then
                        attendance = (Convert.ToDecimal(attendance) + Convert.ToDecimal(dtfilter.Rows(j)("attendance").ToString)).ToString
                    End If
                    sponsorname = sponsorname + dtfilter.Rows(j)("SponsorName").ToString + ","
                    If dtfilter.Rows(j)("SponsorName").ToString <> "" Then
                        Hsponsorname = Hsponsorname + dtfilter.Rows(j)("hSponsorName").ToString + ","
                    Else
                        Hsponsorname = Hsponsorname + dtfilter.Rows(j)("SponsorName").ToString + ","
                    End If


                Next
                dtTableData.Rows(i)("DueFees") = DueFees.ToString()
                dtTableData.Rows(i)("ReceivedFees") = ReceivedFees.ToString()
                dtTableData.Rows(i)("NoOfParticipants") = NoOfParticipants.ToString()
                dtTableData.Rows(i)("NoOfParticipants_Registered") = NoOfParticipants_Registered.ToString()
                dtTableData.Rows(i)("attendance") = attendance.ToString()
                If sponsorname <> "" Then
                    dtTableData.Rows(i)("SponsorName") = sponsorname.Substring(0, sponsorname.Length - 1)
                End If
                If Hsponsorname <> "" Then
                    dtTableData.Rows(i)("Hsponsorname") = Hsponsorname.Substring(0, Hsponsorname.Length - 1)
                End If

                exitstingData.Add(dtTableData.Rows(i)("TrainingId").ToString)
            Next
            dtTableData.DefaultView.RowFilter = "Deletedrow is null"
            dtTableData = dtTableData.DefaultView.ToTable
            Dim dtdatatablenew As New DataTable
            dtdatatablenew = dtTableData.Clone
            dtdatatablenew.Columns("trainingcode").DataType = GetType(String)


