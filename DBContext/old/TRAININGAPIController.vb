    Public Function SAVE_IMAGE_IN_FOLDER(ByVal basestr As String, ByVal imgname As String, ByVal Foldername As String) As Boolean


        Dim sptbase64String() As String = basestr.Split(",")
        Dim base64String As String = sptbase64String(1)

        '***Save Base64 Encoded string as Image File***

        'Convert Base64 Encoded string to Byte Array.
        Dim imageBytes As Byte() = Convert.FromBase64String(base64String)
        'Dim sptData() As String = imgname.Split(".")
        Dim name = imgname
        'Save the Byte Array as Image File.
        Dim filePath As String = Server.MapPath("~/" + Foldername + "/" + Path.GetFileName(name))
        System.IO.File.WriteAllBytes(filePath, imageBytes)
        Return True
    End Function

