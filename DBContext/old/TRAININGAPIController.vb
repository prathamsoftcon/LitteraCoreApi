                End If


                dtTableData.DefaultView.RowFilter = "guestfacultyid='" + dtTableData.Rows(i)("guestfacultyid").ToString + "' and tyaam_typeid='" + dtTableData.Rows(i)("tyaam_typeid").ToString + "'"
