    Public Function UploadFileChunks(ByVal Foldername As String) As JsonResult
        Dim files = Request.Files
        If files.Count > 0 Then
            Try
                Dim filepath As String = Path.Combine(GetUploadPath(Foldername), files(0).FileName)
                Using fs As FileStream = New FileStream(filepath, FileMode.Append)
                    Dim bytes = GetBytes(files(0).InputStream)
                    fs.Write(bytes, 0, bytes.Length)
                End Using
                Return Json(New With {Key .status = True})
            Catch ex As Exception
                Return Json(New With {Key .status = False, Key .message = ex.Message})
            End Try
        End If

        Return Me.Json(True, JsonRequestBehavior.AllowGet)
    End Function
    Private Function GetUploadPath(Foldername) As String
        Dim rootPath = System.Web.Hosting.HostingEnvironment.MapPath("~/" + Foldername)
        'Dim rootPath = System.Web.Hosting.HostingEnvironment.MapPath("/uploadpath")

        If Not Directory.Exists(rootPath) Then
            Directory.CreateDirectory(rootPath)
        End If
        Return rootPath
    End Function
    Private Function GetBytes(ByVal input As Stream) As Byte()
        Dim buffer As Byte() = New Byte(input.Length - 1) {}
        Using ms As MemoryStream = New MemoryStream()
            Dim read As Integer
            'While ((read = input.Read(buffer, 0, buffer.Length)) > 0)
            '    ms.Write(buffer, 0, read)
            'End While
#Disable Warning BC40000 ' 'Public Shared Function __Assign(Of Integer)(ByRef target As Integer, value As Integer) As Integer' is obsolete: 'Please refactor calling code to use normal visual assignemnt'.
            While (CSharpImpl.__Assign(read, input.Read(buffer, 0, buffer.Length))) > 0
#Enable Warning BC40000 ' 'Public Shared Function __Assign(Of Integer)(ByRef target As Integer, value As Integer) As Integer' is obsolete: 'Please refactor calling code to use normal visual assignemnt'.
                ms.Write(buffer, 0, read)
            End While
            Return ms.ToArray()
        End Using
    End Function
