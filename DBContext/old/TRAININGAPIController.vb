    Public Function Register_User(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal XMLparam As String, ByVal XMLName As String, ByVal CreatedOnParameter As String, ByVal ImageParam As String, ByVal Folder_Name As String, ByVal Base64DocType As String, ByVal uploadpath As String, ByVal APIKEY As String)
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")

        If uploadpath <> "" Then
            Dim sptimg = uploadpath.Split("~")
            For Each img In sptimg
                If System.IO.File.Exists(Server.MapPath("~/Temp_Upload/" + img)) Then
                    System.IO.File.Move(Server.MapPath("~/Temp_Upload/" + img), Server.MapPath("~/Training_Upload/" + img))
                End If
            Next

        End If

        If XMLparam = "" Then
            XMLparam = Nothing
        End If
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing






        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
