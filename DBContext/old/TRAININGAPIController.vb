    Public Function GetInstrumentTable(Domain, IsOnline, Sponsorid, Fromdt, todt, Print_hf) As DataTable
        Dim dt As New DataTable
        Dim dtinstrument As DataTable = dm.GETINSTRUMENTDETAIL(Domain, IsOnline, Sponsorid, Get_DB_Date(Fromdt).ToString("yyyy/MM/dd"), Get_DB_Date(todt).ToString("yyyy/MM/dd"))

        With dt.Columns
            .Add("letterno")
            .Add("letterdate")
            .Add("Deptletterdate")
            .Add("chequeamount")
            .Add("chequeno")
            .Add("chequedate")
            .Add("mptcno")
            .Add("mptcdate")
            .Add("Sponsorid")
        End With
        Dim ChkCount, LetterNo, LetterReciveddate, Letterdate, Amount, Chequeno, Dte, hiddensponsorid, mpptcbookno, mpptccodeno, mpptcdateno As String
        Dim DeptLetterDate As String = Nothing
        Dim sptdata() As String = Print_hf.Split("#")
        For i = 0 To sptdata.Length - 1

            If sptdata(i) = "" Then
                Continue For
            End If
            Dim sptField() As String = sptdata(i).Split("*")

            ChkCount = sptField(0)
            LetterNo = sptField(1)
            LetterReciveddate = sptField(2)
            Letterdate = sptField(3)
            Amount = sptField(4)
            Chequeno = sptField(5)
            Dte = sptField(6)
            hiddensponsorid = sptField(7)
            mpptcbookno = sptField(8)
            mpptccodeno = sptField(9)
            mpptcdateno = sptField(10)

            If ChkCount = "0" Then Continue For
            If mpptcbookno = "" OrElse mpptcbookno = "&nbsp;" Then Continue For

            DeptLetterDate = Letterdate

            dt.LoadDataRow(New Object() {LetterNo, LetterReciveddate, DeptLetterDate, Amount, Chequeno, Dte, mpptcbookno & "/" & mpptccodeno, mpptcdateno, hiddensponsorid}, False)

        Next
        Return dt
    End Function
