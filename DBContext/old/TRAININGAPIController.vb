    Public Function GetPanelRights(ByVal Domain As String, ByVal IsOnline As String, ByVal FormId As String, ByVal FormRoleId As String, ByVal APIKEY As String, ByVal createdby As String) As String
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing
        Dim dset As New DataSet
        Dim Param As New Dictionary(Of String, Object)

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If

        If System.Web.HttpContext.Current.Session("IsMySQL") = "1" Then
            If FormId = 0 Then
                Param.Add("v_FormID", DBNull.Value)
            Else
                Param.Add("v_FormID", FormId.ToString)
            End If

            Param.Add("v_FormRoleID", FormRoleId.ToString)
            dset = GetList(Domain, IsOnline, "yuser_GetFormRights", ComTy.StoredProcedure, Param, RSetMode.DataSet)
        Else
            If FormId = 0 Then
                Param.Add("FormID", DBNull.Value)
            Else
                Param.Add("FormID", FormId.ToString)
            End If

            Param.Add("FormRoleID", FormRoleId.ToString)
            Param.Add("userid", createdby)
            dset = GetList(Domain, IsOnline, "YUser.GetFormRights", ComTy.StoredProcedure, Param, RSetMode.DataSet)
        End If

        ' **********code for set update  and delete rights false if user has no insert right as per sheet no 1359****************************************************
        If dset.Tables(0).Rows.Count > 0 Then
            With dset.Tables(0)
                ' FrmRights.Insert = .Rows(0).Item("InsertRight").ToString
                If .Rows(0).Item("InsertRight") = False Then
                    .Rows(0).Item("UpdateRight") = False
                    .Rows(0).Item("DeleteRight") = False
                End If
                If Not System.Web.HttpContext.Current.Session("DataReport") Is Nothing Then
                    'check session is for datareport or entry
                    If System.Web.HttpContext.Current.Session("DataReport") = "2" Then
                        If .Rows(0).Item("FormType").ToString().ToUpper = "TRANSACTION" Then
                            .Rows(0).Item("InsertRight") = False
                            .Rows(0).Item("UpdateRight") = False
                            .Rows(0).Item("DeleteRight") = False
                        End If

                    End If
                End If
            End With
        End If
        '  ***************************************************************


        If dset.Tables(0).Rows.Count <> 0 Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)
            For i = 0 To dset.Tables(0).Rows.Count - 1
                row = New Dictionary(Of String, Object)()
                For j = 0 To dset.Tables(0).Columns.Count - 1
                    row.Add(dset.Tables(0).Columns(j).ColumnName.ToString(), dset.Tables(0).Rows(i)(dset.Tables(0).Columns(j).ColumnName.ToString()).ToString())
                Next
                rows.Add(row)
            Next
        Else
            row = New Dictionary(Of String, Object)()
            row.Add("status", "error")
            row.Add("msg", "you dont have rights")
            rows.Add(row)
        End If

        Dim serializer As New JavaScriptSerializer
        Return serializer.Serialize(rows)
    End Function
    Public Function GetList(ByVal Domain As String, ByVal IsOnline As Boolean, ByVal QryStr As String, ByVal cmdty As ComTy, ByVal par As Dictionary(Of String, Object), ByVal RSetM As RSetMode, Optional ByVal CmdTimeOut As Integer = 1000)
        If System.Web.HttpContext.Current.Session("IsMySQL") = "1" Then
            Dim cOn As MySql.Data.MySqlClient.MySqlConnection = SecureData.GetMysqlConnection(Domain, IsOnline)
            cOn.Open()
            'Dim cnn As SqlConnection = Con
            Dim RecordSet As Object = Nothing
            Dim DSet As New DataSet
            Dim SqlAdp As MySql.Data.MySqlClient.MySqlDataAdapter = Nothing
            Dim cmd As MySql.Data.MySqlClient.MySqlCommand = Nothing
            '  Try

            Select Case RSetM
                Case RSetMode.DataReader
                    cmd = New MySql.Data.MySqlClient.MySqlCommand(QryStr, cOn)
                    Select Case cmdty
                        Case ComTy.StoredProcedure
                            cmd.CommandType = CommandType.StoredProcedure
                        Case ComTy.Text
                            cmd.CommandType = CommandType.Text
                    End Select

                    cmd.CommandTimeout = CmdTimeOut

                    If par IsNot Nothing Then
                        For Each key As KeyValuePair(Of String, Object) In par
                            If key.Value IsNot Nothing Then
                                cmd.Parameters.Add(New SqlParameter(key.Key, key.Value))
                            End If
                        Next
                    End If
                    RecordSet = cmd.ExecuteReader
                Case RSetMode.DataSet
                    SqlAdp = New MySql.Data.MySqlClient.MySqlDataAdapter(QryStr, cOn)
                    Select Case cmdty
                        Case ComTy.StoredProcedure
                            SqlAdp.SelectCommand.CommandType = CommandType.StoredProcedure
                        Case ComTy.Text
                            SqlAdp.SelectCommand.CommandType = CommandType.Text
                    End Select

                    SqlAdp.SelectCommand.CommandTimeout = 8000

                    If par IsNot Nothing Then
                        For Each key As KeyValuePair(Of String, Object) In par
                            If key.Value IsNot Nothing Then
                                SqlAdp.SelectCommand.Parameters.AddWithValue(key.Key, key.Value)
                            End If
                        Next
                    End If
                    SqlAdp.Fill(DSet)
                    RecordSet = DSet
                    SqlAdp.Dispose()

            End Select
            cOn.Close()
            Return RecordSet

        Else
            Dim cOn As SqlConnection = dm.Get_Connection_String(Domain, IsOnline)
            cOn.Open()
            'Dim cnn As SqlConnection = Con
            Dim RecordSet As Object = Nothing
            Dim DSet As New DataSet
            Dim SqlAdp As SqlDataAdapter = Nothing
            Dim cmd As SqlCommand = Nothing
            '  Try

            Select Case RSetM
                Case RSetMode.DataReader
                    cmd = New SqlCommand(QryStr, cOn)
                    Select Case cmdty
                        Case ComTy.StoredProcedure
                            cmd.CommandType = CommandType.StoredProcedure
                        Case ComTy.Text
                            cmd.CommandType = CommandType.Text
                    End Select

                    cmd.CommandTimeout = CmdTimeOut

                    If par IsNot Nothing Then
                        For Each key As KeyValuePair(Of String, Object) In par
                            If key.Value IsNot Nothing Then
                                cmd.Parameters.Add(New SqlParameter(key.Key, key.Value))
                            End If
                        Next
                    End If
                    RecordSet = cmd.ExecuteReader
                Case RSetMode.DataSet
                    SqlAdp = New SqlDataAdapter(QryStr, cOn)
                    Select Case cmdty
                        Case ComTy.StoredProcedure
                            SqlAdp.SelectCommand.CommandType = CommandType.StoredProcedure
                        Case ComTy.Text
                            SqlAdp.SelectCommand.CommandType = CommandType.Text
                    End Select

                    SqlAdp.SelectCommand.CommandTimeout = 8000

                    If par IsNot Nothing Then
                        For Each key As KeyValuePair(Of String, Object) In par
                            If key.Value IsNot Nothing Then
                                SqlAdp.SelectCommand.Parameters.AddWithValue(key.Key, key.Value)
                            End If
                        Next
                    End If
                    SqlAdp.Fill(DSet)
                    RecordSet = DSet
                    SqlAdp.Dispose()

            End Select
            cOn.Close()
            Return RecordSet
        End If


        'Catch ex As Exception
        '    MsgBox(ex.Message, MsgBoxStyle.Critical, "Yojna")
        '    Return RecordSet
        'End Try
    End Function
    Enum ComTy
        StoredProcedure
        Text
    End Enum
    Enum RSetMode
        DataReader
        DataSet
    End Enum
    Public Function Save_Data(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal XMLparam As String, ByVal XMLName As String, ByVal CreatedOnParameter As String, ByVal ImageParam As String, ByVal Folder_Name As String, ByVal Base64DocType As String, ByVal APIKEY As String)
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")





        If XMLparam = "" Then
            XMLparam = Nothing
        End If
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If
        Try
            Dim dtParam As New DataTable
            Dim dtXMLparam As New DataTable
            If Parameters IsNot Nothing Then
                dtParam = DerializeDataTable(Parameters)
            End If

            If XMLparam IsNot Nothing Then
                dtXMLparam = DerializeDataTable(XMLparam)
            End If

            If Not ImageParam Is Nothing Then
                Dim doctype = "jpeg"
                If Base64DocType <> "" Then
                    If (Base64DocType = "1") Then
                        doctype = "jpg"
                    ElseIf Base64DocType = "2" Then
                        doctype = "jpg"
                    ElseIf Base64DocType = "3" Then
                        doctype = "pdf"
                    ElseIf Base64DocType = "4" Then
                        doctype = "docx"
                    ElseIf Base64DocType = "5" Then
                        doctype = "xls"
                    ElseIf Base64DocType = "6" Then
                        doctype = "ppt"
                    ElseIf Base64DocType = "7" Then
                        doctype = "txt"

                    End If
                End If



                For i = 0 To dtParam.Rows.Count - 1
                    If dtParam.Rows(i)(ImageParam).ToString <> "" Then
                        Dim bytess() As Byte = Convert.FromBase64String(dtParam.Rows(i)(ImageParam).ToString)
                        Dim imagename1 As String = Guid.NewGuid().ToString() + "." + doctype
                        Dim imagePath1 As String = Server.MapPath("~/" + Folder_Name + "/" + imagename1 + "")
                        Using imagefile As FileStream = New FileStream(imagePath1, FileMode.Create)
                            imagefile.Write(bytess, 0, bytess.Length)
                            imagefile.Flush()
                        End Using
                        dtParam.Rows(i)(ImageParam) = Folder_Name + "/" + imagename1 + ""
                    End If
                Next




                '
            End If
            Dim dtReturnstr As New DataTable
            If dm.Save_Common_Data(Domain, IsOnline, ProcedureName, dtParam, dtXMLparam, XMLName, CreatedOnParameter) = True Then
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Success")
                rows.Add(row)
            Else
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", "Data not save try again")
                rows.Add(row)
            End If


        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Save_Data  " + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - Save_Data  " + exce.Message)
            'LblError.Text = exce.Message
