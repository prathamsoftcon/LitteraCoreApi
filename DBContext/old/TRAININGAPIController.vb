                                AsstDiractor = .Item("ASSOCIATEDIRECTORName").ToString.ToUpper
                                FromDate = CDate(.Item("T_Startdate").ToString).ToString("dd/MM/yyyy")
                                ' txtFrom.Text = FromDate
                                ToDate = CDate(.Item("T_closingDate").ToString).ToString("dd/MM/yyyy")
                                ' txtTo.Text = ToDate
                                ' trainingcode = .Item("coursecode").ToString

                                DurationType = .Item("durationtype").ToString

                                If DurationType = "Weeks" Then
                                    DurationType = "सप्ताह"
                                Else
                                    DurationType = "दिन"

                                End If


                                Duration = .Item("duration").ToString & " " & DurationType
                                LevelofTraining = .Item("ParticipantLevel").ToString
                            Else
                                'If CType(.Item("Training_SponsorType").ToString, Byte) = 2 Then
                                '    Department = "संयुक्त विभाग"
                                'Else
                                Department &= ", " & .Item("HSponsorName").ToString
                                'End If
                                Trainingcordinator = .Item("HCOURSEDIRECTORName").ToString.ToUpper
                                AsstDiractor = .Item("HASSOCIATEDIRECTORName").ToString.ToUpper
