    Public Function Get_Trg_Fees_Per_participant(ByVal Domain As String, ByVal isonline As String, ByVal trgid As String) As String
        Dim feesperparticipant As Decimal = 0.00
        Dim discountpercent As Decimal = 0.00
        Dim dtexp As DataTable = dm.GetTrainingPlanDetails(Domain, isonline, trgid, Nothing, Nothing).Tables(1)
        For i = 0 To dtexp.Rows.Count - 1
            If dtexp.Rows(i)("T_ExpHeadId").ToString.ToUpper <> "417119B3-18B6-43A1-8A52-064E99B6880E" Then
                If dtexp.Rows(i)("T_Rate").ToString <> "" Then
                    feesperparticipant = feesperparticipant + CDbl(dtexp.Rows(i)("T_Rate").ToString)
                End If

            Else
                If dtexp.Rows(i)("T_Rate").ToString <> "" Then
                    discountpercent = discountpercent + CDbl(dtexp.Rows(i)("T_Rate").ToString)
                End If

            End If
        Next
        feesperparticipant = feesperparticipant - ((feesperparticipant * discountpercent)) / 100
        Return feesperparticipant.ToString()
    End Function

