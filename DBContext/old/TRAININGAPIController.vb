                        Dim bytess() As Byte = Convert.FromBase64String(dtParam.Rows(i)(ImageParam).ToString)
                        Dim imagename1 As String = Guid.NewGuid().ToString() + "." + doctype
                        Dim imagePath1 As String = Server.MapPath("~/" + Folder_Name + "/" + imagename1 + "")
                        Using imagefile As FileStream = New FileStream(imagePath1, FileMode.Create)
