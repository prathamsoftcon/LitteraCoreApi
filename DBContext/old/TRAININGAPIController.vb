                    trainingcode = dsTrainingDetails.Tables(3).Rows(0).Item("trainingcode").ToString

                End If

                If dsTrainingDetails.Tables(0).Rows.Count > 0 Then

                    t_details = dsTrainingDetails.Tables(0).Rows(0).Item("t_Details").ToString
                End If

                If dtTrainging_DTL.Rows.Count > 0 Then
                    For index As Int16 = 0 To dtTrainging_DTL.Rows.Count - 1

                        With dtTrainging_DTL.Rows(index)

                            If Me.Session("Choice") = 1 Then
                                'Department = .Item("sponsorname").ToString.ToUpper
                                'If CType(.Item("Training_SponsorType").ToString, Byte) = 2 Then
                                '    Department = "Joint Department"
                                'Else
#Disable Warning BC42104 ' Variable 'Department' is used before it has been assigned a value. A null reference exception could result at runtime.
