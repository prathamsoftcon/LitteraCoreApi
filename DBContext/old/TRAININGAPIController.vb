    Public Function Save_TimeTable_Data_New(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal TimetableXML As String, ByVal CreatedOnParameter As String, ByVal APIKEY As String, ByVal trainingid As String, ByVal T_name As String, ByVal T_Code As String, ByVal startdate As String, ByVal isnew As String, ByVal agencytypeid As String, ByVal branchid As String)
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        If TimetableXML = "" Then
            TimetableXML = Nothing
        End If
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If

        Try
            Dim dtParam As New DataTable
            Dim dtXMLparam As New DataTable
            If Parameters IsNot Nothing Then
                dtParam = DerializeDataTable(Parameters)
            End If
            Dim TTXML As String = Nothing
            If TimetableXML IsNot Nothing Then

                dtXMLparam.Columns.Add("TTTTT_SESSION_ROW_NO")
                dtXMLparam.Columns.Add("TTTTT_SESSION_ID")
                dtXMLparam.Columns.Add("TTTTT_FACULTYID")
                dtXMLparam.Columns.Add("TTTTT_CONTENT_DESC")
                dtXMLparam.Columns.Add("TTTTT_SESSION_DT")
                dtXMLparam.Columns.Add("TTTTT_SESSION_DAY")
                dtXMLparam.Columns.Add("TTTTT_SESSION_TIME")
                dtXMLparam.Columns.Add("TTTTT_SESSION_DURATION")
                dtXMLparam.Columns.Add("TTTTT_IS_JOINT_SESSION")
                dtXMLparam.Columns.Add("TTTTT_SESSION_NO")
                dtXMLparam.Columns.Add("TTTTT_SESSION_END_TIME")
                dtXMLparam.Columns.Add("TTTTT_STATUS")
                dtXMLparam.Columns.Add("TTTTT_REMARK")
                dtXMLparam.Columns.Add("TTTTT_SESSION_WEEK")
                dtXMLparam.Columns.Add("TTTTT_RECURRINGID")

                dtXMLparam.Columns.Add("TTTTT_TYPE")
                dtXMLparam.Columns.Add("TTTTT_SUBJECT")

                dtXMLparam.Columns.Add("TTTTT_SESSION_DURATION_TYPE")
                If TimetableXML.ToString().Trim <> "" Then
                    Dim sptHidden = TimetableXML.Split("#")
                    Dim dr As DataRow
                    For i = 0 To sptHidden.Length - 1
                        dr = dtXMLparam.NewRow
                        If sptHidden(i) = "" Then
                            Continue For
                        End If

                        Dim sptData = sptHidden(i).Split("*")
                        If sptData(0).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_ROW_NO") = sptData(0)
                        Else
                            dr("TTTTT_SESSION_ROW_NO") = Nothing
                        End If
                        If sptData(1).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_ID") = sptData(1)
                        Else
                            dr("TTTTT_SESSION_ID") = Nothing
                        End If
                        If sptData(2).ToString.Trim <> "" Then
                            dr("TTTTT_FACULTYID") = sptData(2)
                        End If
                        If sptData(3).ToString.Trim <> "" Then
                            dr("TTTTT_CONTENT_DESC") = sptData(3)
                        Else
                            dr("TTTTT_CONTENT_DESC") = Nothing
                        End If
                        If sptData(4).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_DT") = sptData(4)
                        Else
                            dr("TTTTT_SESSION_DT") = Nothing
                        End If
                        If sptData(5).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_TIME") = sptData(5)
                        Else
                            dr("TTTTT_SESSION_TIME") = Nothing
                        End If

                        'Code to convert Duration according to duration type because in each case we send duration in min only
                        'According to discussion on 3.1.2023 with NG Ref - if not in min how to calculate avg man hours
                        Dim Duratiomin As String = ""

                        If sptData(17) = "2" Then  'Hour
                            Duratiomin = CDbl(sptData(6)) * 60
                        ElseIf sptData(17) = "3" Then 'Day
                            Duratiomin = CDbl(sptData(6)) * 1440
                        Else
                            Duratiomin = sptData(6)
                        End If
                        If sptData(6).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_DURATION") = Duratiomin
                        Else
                            dr("TTTTT_SESSION_DURATION") = Nothing
                        End If

                        If sptData(7).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_DAY") = sptData(7)
                        Else
                            dr("TTTTT_SESSION_DAY") = Nothing
                        End If

                        If sptData(8).ToString.Trim <> "" Then
                            dr("TTTTT_IS_JOINT_SESSION") = sptData(8)
                        Else
                            dr("TTTTT_IS_JOINT_SESSION") = Nothing
                        End If


                        If sptData(9).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_NO") = sptData(9)
                        Else
                            dr("TTTTT_SESSION_NO") = Nothing
                        End If

                        'Calculate end datetime

                        Dim enddt As DateTime = CDate(sptData(4) + " " + sptData(5))

                        If sptData(17) = "2" Then  'Hour
                            enddt = enddt.AddHours(sptData(6))
                        ElseIf sptData(17) = "3" Then 'Day
                            enddt = enddt.AddDays(sptData(6))
                        Else
                            enddt = enddt.AddMinutes(sptData(6))
                        End If


                        If sptData(10).ToString.Trim <> "" Then
                            'Logic That Session end time can not be beyond date
                            If CDate(sptData(4)).Date = CDate(enddt.ToString("yyyy/MM/dd hh:mm:ss")).Date Then
                                dr("TTTTT_SESSION_END_TIME") = enddt.ToString("yyyy/MM/dd HH:mm:ss")
                            Else
                                dr("TTTTT_SESSION_END_TIME") = sptData(4) + " 23:59:00"
                            End If

                        Else
                            dr("TTTTT_SESSION_END_TIME") = Nothing
                        End If








                        If sptData(11).ToString.Trim <> "" Then
                            dr("TTTTT_STATUS") = sptData(11)
                        Else
                            dr("TTTTT_STATUS") = Nothing
                        End If

                        'If sptData(12).ToString.Trim <> "" Then
                        '    dr("TTTTT_REMARK") = sptData(12)
                        'Else
                        '    dr("TTTTT_REMARK") = Nothing
                        'End If
                        If sptData(13).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_WEEK") = sptData(13)
                        Else
                            dr("TTTTT_SESSION_WEEK") = Nothing
                        End If



                        If sptData(14).ToString.Trim <> "" Then
                            dr("TTTTT_TYPE") = sptData(14)
                        Else
                            dr("TTTTT_TYPE") = Nothing
                        End If

                        If sptData(15).ToString.Trim <> "" Then
                            dr("TTTTT_SUBJECT") = sptData(15)
                        Else
                            dr("TTTTT_SUBJECT") = Nothing
                        End If

                        If sptData(16).ToString.Trim <> "" Then
                            dr("TTTTT_RECURRINGID") = sptData(16)
                        Else
                            dr("TTTTT_RECURRINGID") = Nothing
                        End If

                        If sptData(17).ToString.Trim <> "" Then
                            dr("TTTTT_SESSION_DURATION_TYPE") = sptData(17)
                        Else
                            dr("TTTTT_SESSION_DURATION_TYPE") = Nothing
                        End If


                        dtXMLparam.Rows.Add(dr)
                    Next
                End If
                'dtXMLparam = DerializeDataTable(TimetableXML)
                Dim Wr As New System.IO.StringWriter

                If dtXMLparam.Rows.Count > 0 Then
                    dtXMLparam.TableName = "TrainingSchedule"
                    dtXMLparam.WriteXml(Wr)
                    TTXML = Wr.ToString()
                End If


            End If
            Dim dtReturnstr As New DataTable
            If dm.Save_TT_Data(Domain, IsOnline, ProcedureName, dtParam, TTXML, CreatedOnParameter) = True Then


                '**************************Code to send mail 


                Dim messagetype As String = ""
                Dim mailsubject As String = ""
                Dim mailtext As String = ""
                Dim es As New EmailTemplate
                es = dm.Get_EMAIL_TEMPLATE("SESSIONCREATION")
                mailsubject = es.subject
                mailtext = es.text.Replace("(#trgid#)", trainingid)






                Dim subject As String = ""



                If isnew = "1" Then
                    mailsubject = mailsubject.Replace("(#trgname#)", T_name)
                    mailsubject = mailsubject.Replace("(#trgcode#)", T_Code)
                    mailsubject = mailsubject.Replace("(#trgstartdate#)", startdate)
                Else
                    mailsubject = mailsubject.Replace("(#trgname#)", T_name)
                    mailsubject = mailsubject.Replace("(#trgcode#)", T_Code)
                    mailsubject = mailsubject.Replace("(#trgstartdate#)", startdate)
                    mailsubject = mailsubject.Replace("Session Created", "Session Updated")
                End If
                subject = mailsubject

                Dim dttrgdetails As DataTable = dm.Get_Trg_Data_New(Domain, IsOnline, trainingid).Tables(0)


                mailtext = mailtext.Replace("(#trgname#)", T_name)
