    Function Get_12_Hour_Time_Format(ByVal time As String) As String
        Dim rettime As String = ""
        Dim spttime() As String = time.Split(":")

        If (Convert.ToInt16(spttime(0)) > 12) Then
            Dim hh = Convert.ToInt16(spttime(0)) - 12
            rettime = hh.ToString + ":" + spttime(1) + " PM"
        Else
            If (Convert.ToInt16(spttime(0)) = 0) Then
                rettime = "12" + ":" + spttime(1) + " AM"
            ElseIf (Convert.ToInt16(spttime(0)) = 12) Then
                rettime = "12" + ":" + spttime(1) + " PM"
            Else
                rettime = spttime(0) + ":" + spttime(1) + " AM"

            End If
        End If
        Return rettime
    End Function




