                    Return serializer3.Serialize(rows)
                End If

            End If






            '*************************************






            dt_trg_to_week_day.DefaultView.RowFilter = "datevalue='" + sesiondate.Replace("-", "/") + "'"
            dt_trg_to_week_day = dt_trg_to_week_day.DefaultView.ToTable
            'Get Weekid and dayid for particular date
            If dt_trg_to_week_day.Rows.Count > 0 Then
                sessionday = dt_trg_to_week_day.Rows(0)("daycount").ToString
                sessionweek = dt_trg_to_week_day.Rows(0)("weekcount").ToString
            End If
            If dt_trg_to_time_table.Rows.Count > 0 Then
                timetableid = dt_trg_to_time_table.Rows(0)("ttttt_timetableid").ToString
            Else
                timetableid = Guid.NewGuid.ToString
            End If
            dt_trg_to_time_table.DefaultView.RowFilter = "ttttt_session_week='" + sessionweek + "' and ttttt_type <>'2'"
            dt_trg_to_time_table = dt_trg_to_time_table.DefaultView.ToTable

            sessionno = (dt_trg_to_time_table.Rows.Count + 1).ToString


            'Validation if alrady session exist for this date and time

            'dt_trg_to_time_table.DefaultView.RowFilter = "ttttt_session_dt='" + sessiondate + "' and "

            'Save Data



            Dim dtReturnstr As New DataTable
            If dm.Save_Clone_Session_Details(Domain, IsOnline, trainingid, timetableid, createdby, branchid, sessionid, facultyid, contentdesc, subject, sessiontype, sessiondate, sessionday, sessionweek, durationmin, sessionrowno, isjointsession, sessionno, sessiontime, enddatetwithtime, status, remark, tag, durationtype, "0") = True Then
                '**************Upload Content*************
                If iscopycontent <> "0" Then
                    Dim dssessiondetails As DataSet
                    Dim dtsessionmaster As New DataTable
                    Dim dtsessiondetail As New DataTable
                    dssessiondetails = dm.Get_Session_DETAIL(Domain, IsOnline, clone_from_sessionid)
                    dtsessionmaster = dssessiondetails.Tables(0)

                    '*************Filter data for only Current user
                    dtsessionmaster.DefaultView.RowFilter = "ttsar_user_type_id='" + usertype + "'"
                    dtsessionmaster = dtsessionmaster.DefaultView.ToTable
                    '**********
                    'dtsessiondetail = dssessiondetails.Tables(1)

                    If iscopycontent = "1" Then  'Copy As Child
                        For i = 0 To dtsessionmaster.Rows.Count - 1


                            dm.Save_Session_Attachment(Domain, IsOnline, cloneto_trgid, cloneto_trg_cat_id, sessionid, branchid, dtsessionmaster.Rows(i)("ttsad_title").ToString, Nothing, dtsessionmaster.Rows(i)("GlobalContentyTypeID").ToString, Guid.NewGuid.ToString, dtsessionmaster.Rows(i)("GlobalFilePath").ToString, dtsessionmaster.Rows(i)("GlobalWysiwagText").ToString, createdby, dtsessionmaster.Rows(i)("ttsam_id").ToString, "1", dtsessionmaster.Rows(i)("ttsad_tag").ToString, "1", usertype, loginempid, loginempid, dtsessionmaster.Rows(i)("GlobalFileName").ToString, dtsessionmaster.Rows(i)("GlobalContentFolderID").ToString, dtsessionmaster.Rows(i)("tdds_status").ToString, dtsessionmaster.Rows(i)("ttsam_globalcontentid").ToString)
                        Next


                    ElseIf iscopycontent = "2" Then  'Copy As Sibling/Seprate

                        For i = 0 To dtsessionmaster.Rows.Count - 1

