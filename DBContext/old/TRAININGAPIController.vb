            Dim editabledata As String = "<p><span><b><u>महानिदेशक /संचालक द्वारा अनुमोदित </u></b></span> </p> <p><span>नोट:-1. यदि इस कार्यक्रम में महामहिम राज्यपाल/माननीय मुख्यमंत्री/केंद्रीय मंत्री या अन्य विशिष्ट अधिकारी आ रहे हों तो कृपया महानिदेशक प्रशासान अकादमी को व्यक्तिगत रूप से उनके कार्यक्रम से अगिम सूचित करने का कष्ट करें </span> </p> <p><span>2- भोजन चाय आदि व्यवस्था को अंतिम रूप देने के लिये प्रभारी अधिकारी मैस, (0755-2445035)  अकादमी कार्या. से संपर्क करें। </span> </p> <p><span>3- कार्यक्रम के उपयोग में लाये जाने वाले बैनर, डिस्प्ले आदि द्विभाषा (हिन्दी/अग्रेजी) में होना अनिवार्य होगा। </span> </p> <p><span>4- भुगतान राशि का चेक ''महानिदेशक आर.सी.व्ही.पी.नरोन्हा प्रशासन एवं प्रबंधकीय अकादमी भोपाल'' के नाम देय होगा। </span> </p> <p><span>5- आपको हॉल किराये पर दिया जा रहा है। सेमीनार/कार्यशाल में उपस्थित होने वाले प्रतिभागियों को सूचित करें कि उनके ठहरने की व्यवस्था अकादमी छात्रावास में नहीं है। क्योंकि कई प्रतिभागी सूचना के आभाव में अकादमी छात्रावास में कमरे हेतु पधारते हैं एवं व्यवस्था न होने पर उन्हे अनावश्यक कठिनाई एवं परेशानी होती है। </span> </p> <p><span>6- कृपया आरक्षण संबंधित शर्तों का अवलोकन पृष्ठ-2 पर करने का कष्ट करें। </span></p>	    <p><span><b>प्रतिलिपि:- </b> <br>1- निज सहायक, महानिदेशक/संचालक, प्रशासन अकादमी भोपाल की ओर सूचनार्थ। </span></p> <p><span>2- संयुक्त संचलाक (प्रशासन) प्रशासन अकादमी भोपाल की ओर सूचनार्थ। </span></p> <p><span>3- प्रभारी अधिकारी प्रशिक्षण/मैस, प्रशासन अकादमी भोपाल की ओर सूचनार्थ। </span></p> <p><span>4- अधीक्षक, अतिथि <u>भवन/लेखा </u> /संपदा,प्रशासन अकादमी भोपाल की ओर सूचनार्थ। </span></p> <p><span>5- अधीक्षक, <u>प्रशिक्षण </u> शाखा, प्रसान अकादमी भोपाल की ओर सूचनार्थ, कृपया साप्ताहिक कार्यक्रम में शामिल कर सभी संबंधितों को अवगत करायें। </span></p> <p><span>6- अधीक्षक स्थापना, प्रशासन अकादमी भोपाल की ओर,आरक्षण दिवसों में सार्वजनिक अवकाश  हो तो उक्त दिवस स्वागत काउंटर पर स्वागतकर्ता की  डयूटी सुनिश्चित करने हेतु सूचनार्थ। </span></p> <p><span>7- संपदा सुपरवाईजर,प्रशासन अकादमी भोपाल की ओर आवश्यक व्यवस्था/कार्यवाही सुनिश्चित कराने हेतु सूचनार्थ।</span></p> <p><span>8- तकनीकी सहायक, दृष्य एवं श्रव्य,,साउंड आपरेटर, स्वर्ण जंयती सभागार ,प्रशासन अकादमी भोपाल की ओर आनावश्यक व्यवस्था हेतु सूचनार्थ। </span></p> <p><span>9- उद्यान सुपरवाईजर/तल प्रभारी/सफाई सुपरवाईजर (IPS Guard pvt. Ltd.). प्रशा. अका. की ओर आवशयक व्यवस्था सुनिश्चित कराने हेतु। </span></p> <p><span>10- स्वागतकर्ता, स्वागत कक्ष, " + Clientname + " की ओर सूचनार्थ। </span></p>  <p style='text-align:right'><span><b>सह प्रभारी अधिकारी (संपदा)  </b></span> </p>  <table class='old_table' style='width:100%;border:none;font-weight:bold;'> 	<tr> 		<td>पृ.क्र." + dtMaindata.Rows(0)("tthbm_ref_no").ToString + "/ दिनांक " + CDate(dtMaindata.Rows(0)("tthbm_booking_date").ToString).ToString("dd/MM/yyyy") + "</td> 		<td style='text-align:right'>भोपाल,दिनांक " + Common.getDateTime.ToString("dd/MM/yyyy") + "</td> 	</tr> </table>   <p style='text-align:center;font-size:large'><span><b>आरक्षण शर्ते  </b></span> </p> <p><span>1- अकादमी की ओर से हॉल में डायस पर स्थापित माईक तथा अन्य उपकरण के अलावा अलग से कोई उपकरण प्रदाय नहीं किये जावेंगे। </span> </p> <p><span>2- अकादमी द्वारा निर्धारित किये गये मीनू एवं दरों पर केटरिंग की व्यवस्था के लिये मैस ठेकेदार से संपर्क करें। अकादमी की निर्धारित मीनू के अलावा यदि अन्य कोई मीनू तय किया जाता है तो उसकी दरें मैस ठेकेदार एवं आप स्वयं निर्धारित करेंगे। </span> </p> <p><span>3- अकादमी मैस में भोजन की व्यवस्था हेतु निर्धारित फ़्लोर चार्ज अकादमी में अग्रिम जमा करना होगा। </span></p> <p><span>4- हॉल में उपलब्ध फर्नीचर जिस स्थति में रखा था उसी स्थिति में सुपुर्द करना होगा, किसी प्रकार की डैमेज एवं खराबी आने पर डैमेज चार्ज संबंधित संस्था से वसूला जावेगा। उपरोक्त निर्धारित दरे सुबह 9.00  बजे से शाम 5.00 बजे तक (8 धंटे) के लिये निर्धारित है।</span> </p> <p><span>5- निर्धारित समय सुबह 9.00 से 5.00 बजे के बाद यदि संस्था द्वारा उपलब्ध सुविधा का उपयोग किया जाता है तो निर्धारित किराया राशि 8 घंटे की सीमा से विभाजन कर प्रतिघंटा जो राशि प्राप्त होगी, वह राशि अतिरिक्त प्रति घंटे के लिये देय होगी। </span> </p> <p><span>6- रात्रि 10.00 बजे के बाद यदि सभागार एंव उसकी सुविधाओ का उपयोग किया जाता है तो निर्धरित किराया राशि 8 घंटे की सीमा से विभाजन कर जो राशि एंव उसकी 20 प्रतिशत राशि को जोडकर जो राशि होगी वह अतिरिक्त प्रतिघंटे के लिए देय होगी </span><p> <p><span>7- संस्था द्वारा किसी भी सुविधा व्यवस्था के उपयोग के दोरान यदि किसी प्रकार की डैमेज या खराबी आती है तो उसके डैमेज चर्जेस संबन्धित संस्था से वसूल किया जावेगा  </span></p> <p><span>8- निर्धारित किराया शासकीय अर्धशासकीय, अशासकीय संस्थाओ, निगम, मण्डल, सभी के लिये देय होगा। शासकीय/ सार्वजनिक अवकाश के दिनो मे भी किय सामान किराया देय  </span></p> <p><span>9- अशासकीय संस्थाओ ,अर्धशासकीय, संस्थाओ, निगम, मण्डल, आदि को सभागार आरक्षित करने पर रू. 10000/ -का बैंकर्स चैक / ड्राफ़्ट सुरक्षा निधी के रूप मे अकादमी मे जमा करना होगा । सेमीनार/कार्यक्रम समाप्त होने के पश्चात प्रभारी अधिकारी संपदा से नो-ड्यूज जारी करने पर सुरक्षा निधी का बैंकर्स चैक / ड्राफ़्ट रिलीज किया </span></p> <p><span>10- अकादमी मुख्य भवन में किसी भी स्थान पर धूम्रपान नहीं किया जावे। </span> </p> <p><span>11- जलपान/चाय का प्रबंध हॉल के अंदर कतई नहीं किया जावेगा। </span> </p> <p><span>12- हॉल के अंदर या बाहरी दीवारों पर पोस्टर आदि चिपकाना मना है। </span> </p> <p><span>13- अकादमी एक प्रशिक्षण संस्थान है, इसलिये परिसर में किसी प्रकार के झंडे, स्वागत द्वार आदि लगाना मना है।</span> </p> <p><span>14- उपलब्ध कराये गये हॉल में केवल फ़्लावर डेकोरेशन किया जा सकेगा, अन्य किसी प्रकार का डेकोरेशन नहीं किया जावेगा। परिसर मुख्य भवन में कोई कील आदि नहीं ठोकी जायेगी न ही कोई अन्य परिवर्तन किया जायेगा।</span> </p> <p><span>15- सभागार के आरक्षण आदेश जारी होने के 24 घंटे के भीतर निर्धारित किराया विभाग/संस्था द्वारा जमा करना होगा।  </span></p> <p><span>16- हॉल के आरक्षण के पश्चात किसी कारणवश आपका कार्यक्रम,सेमीनार,मीटिंग आदि निरस्त होता है, तो ऐसी स्थिति में जमा किराया धनराशि में से निरस्तीकरण शुल्क के रूप में निम्नानुसार राशि काटी जावेगी। </span> </p>    <table class='old_table' border='1' style='width:90%;border: 2px solid blue: align:center;border-collapse: collapse; text-align: center;'>  	<tr