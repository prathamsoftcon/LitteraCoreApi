                    If dt_Trg_From_Session_info.Rows(j)("ttttt_facultyid").ToString <> "" Then
                        facultyid = facultyid + dt_Trg_From_Session_info.Rows(j)("ttttt_facultyid").ToString + ","
                    End If

                Next
                If facultyid <> "" Then
                    facultyid = facultyid.Substring(0, facultyid.Length - 1)
                End If



            End If




            'Get Training Detail of New Trg ID (Week/Day) details

            Dim ds_Trg_to_Session_info As New DataSet
            ds_Trg_to_Session_info = dm.GetTraining_Session_Details(Domain, IsOnline, cloneto_trgid, branchid, Nothing, Nothing, Nothing, Nothing, Nothing)

            Dim dt_trg_to_week_day As DataTable = ds_Trg_to_Session_info.Tables(2)
            Dim dt_trg_to_time_table As DataTable = ds_Trg_to_Session_info.Tables(0)

            '*********************Function To check This date or time already exist in 
            If sessiontype = "1" Then
                Dim startdatetime As DateTime
                startdatetime = Convert.ToDateTime(sesiondate + " " + sessiontime)
                Dim enddatetime As DateTime
                enddatetime = Convert.ToDateTime(sesiondate + " " + sessionstarttime).AddMinutes(duration)
                Dim meetingList1 As New MeetingList
                meetingList1.AddMeeting(startdatetime, enddatetime)
                Dim meetingList2 As New MeetingList

