                mailtext = mailtext.Replace("(#acdname#)", dttrgdetails.Rows(0)("AssociateDirectorName").ToString)
                mailtext = mailtext.Replace("(#trgstartdate#)", CDate(dttrgdetails.Rows(0)("T_StartDate")).ToString("dd/MM/yyyy"))
                mailtext = mailtext.Replace("(#trgenddate#)", CDate(dttrgdetails.Rows(0)("T_ClosingDate")).ToString("dd/MM/yyyy"))

