            End If

            If XMLparam IsNot Nothing Then
                dtXMLparam = DerializeDataTable(XMLparam)
            End If

            If Not ImageParam Is Nothing Then
                Dim doctype = "jpg"
                For i = 0 To dtParam.Rows.Count - 1
                    If dtParam.Rows(i)("@DOCTYPE").ToString <> "" Then
                        If (dtParam.Rows(i)("@DOCTYPE").ToString = "1") Then
                            doctype = "jpg"
                        ElseIf dtParam.Rows(i)("@DOCTYPE").ToString = "2" Then
                            doctype = "jpg"
                        ElseIf dtParam.Rows(i)("@DOCTYPE").ToString = "3" Then
                            doctype = "pdf"
                        ElseIf dtParam.Rows(i)("@DOCTYPE").ToString = "4" Then
                            doctype = "docx"
                        ElseIf dtParam.Rows(i)("@DOCTYPE").ToString = "5" Then
                            doctype = "xls"
                        ElseIf dtParam.Rows(i)("@DOCTYPE").ToString = "6" Then
                            doctype = "ppt"
                        ElseIf dtParam.Rows(i)("@DOCTYPE").ToString = "7" Then
                            doctype = "txt"

                        End If
                    End If

                Next


                For i = 0 To dtParam.Rows.Count - 1
                    If dtParam.Rows(i)(ImageParam).ToString <> "" Then
                        Dim bytess() As Byte = Convert.FromBase64String(dtParam.Rows(i)(ImageParam).ToString)
                        Dim imagename1 As String = Guid.NewGuid().ToString() + "." + doctype
                        Dim imagePath1 As String = Server.MapPath("~/" + Folder_Name + "/" + imagename1 + "")
                        Using imagefile As FileStream = New FileStream(imagePath1, FileMode.Create)
                            imagefile.Write(bytess, 0, bytess.Length)
                            imagefile.Flush()
                        End Using
                        dtParam.Rows(i)(ImageParam) = Folder_Name + "/" + imagename1 + ""
                    End If
                Next




                '
            End If

            Dim dtReturnstr As New DataTable
            Dim remno As String = dm.Save_Reminder(Domain, IsOnline, ProcedureName, dtParam, dtXMLparam, XMLName, CreatedOnParameter, Branchid)
            Dim printstr As String
            printstr = PrintBill_Bill_REMINDER(Domain, IsOnline, printdata, sponsorid, remno, txtReminderDate, language, reminderid)

            Session("printdata") = printstr.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            row.Add("reminderno", remno)
            row.Add("printdata", printstr.ToString)
            rows.Add(row)

        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Save_Bill_Reminder" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Save_Bill_Reminder" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - Save_Bill_Reminder" + exce.Message)
            'LblError.Text = exce.Message
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - Save_Bill_Reminder" + expe.Message)
            'LblError.Text = expe.Message.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
            logger.Error("TrainingAPI - Save_Bill_Reminder" + ex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message_Front_end(Domain, IsOnline, ex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Save_Bill_Reminder" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        End Try
        Dim serializer As New JavaScriptSerializer
        Return serializer.Serialize(rows)

    End Function


