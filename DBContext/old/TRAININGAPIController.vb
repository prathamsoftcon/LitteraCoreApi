        Try
            Dim isused As String
            isused = dm.chk_reg_mob_no(Domain, isonline, mobileno, sponsorid, trainingid, participantid)
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)

            row = New Dictionary(Of String, Object)()
            row.Add("isExist", isused)
            rows.Add(row)
        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - TRG_CHK_REG_MOB_NO  " + sqlex.Message)
