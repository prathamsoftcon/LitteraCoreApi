            End If




            For i = 0 To dtTableData.Rows.Count - 1
                HF_TREE_SESSION_ALL_DATA = HF_TREE_SESSION_ALL_DATA + dtTableData.Rows(i)("ttttt_session_id").ToString + "*" + dtTableData.Rows(i)("ttttt_session_dt").ToString + "*" + dtTableData.Rows(i)("ttttt_session_time").ToString + "*" + dtTableData.Rows(i)("ttttt_type").ToString + "*" + dtTableData.Rows(i)("ttttt_complimentory").ToString + "#"
                HF_ALL_VISIBLE_SESSION_LIST = HF_ALL_VISIBLE_SESSION_LIST + dtTableData.Rows(i)("ttttt_session_id").ToString + ","
                HF_SESSION_FACULTY_DATA = HF_SESSION_FACULTY_DATA + dtTableData.Rows(i)("ttttt_session_id").ToString + "*" + dtTableData.Rows(i)("guestfacultyname").ToString + "*" + dtTableData.Rows(i)("facultyimage").ToString + "*" + dtTableData.Rows(i)("ttttt_facultyid").ToString + "#"

            Next



            For i = 0 To dtselfpaced.Rows.Count - 1
                HF_ALL_VISIBLE_SESSION_LIST = HF_ALL_VISIBLE_SESSION_LIST + dtselfpaced.Rows(i)("ttttt_session_id").ToString + ","

            Next
            If dtselfpaced.Rows.Count > 0 Then
                Dim n As New nodes
                n.text = "Self Paced"
                n.icon = "fa fa-book"
                n.title = "Self Paced"
                n.id = "D_Self Paced"
                Dim cn As New List(Of nodes)
                For Each selfrows In dtselfpaced.Rows
                    Dim selfpacedesc As String = ""
                    If selfrows("ttttt_content_desc").ToString.Length > 15 Then
                        selfpacedesc = "SR#" + selfrows("session_no") + "-" + selfrows("ttttt_content_desc").ToString.ToLower.Substring(0, 13) + "..-"
                        selfpacedesc = selfpacedesc.Replace("'", "^")
                    Else
                        selfpacedesc = "SR#" + selfrows("session_no") + "-" + selfrows("ttttt_content_desc").ToString.ToLower
                        selfpacedesc = selfpacedesc.Replace("'", "^")
                    End If
                    Dim cnc As New nodes
                    cnc.text = selfpacedesc
                    cnc.icon = "fa fa-book"
                    cnc.title = selfrows("ttttt_content_desc").ToString.ToLower.Replace("'", "^")
                    cnc.id = "S_" + selfrows("ttttt_session_id").ToString.ToString().ToUpper()
                    cn.Add(cnc)
                Next
                n.nodes = cn.ToArray()
                subnodes.Add(n)
            End If




            mainnode.nodes = subnodes.ToArray()
            tree.Add(mainnode)



            If HF_ALL_VISIBLE_SESSION_LIST <> "" Then
                HF_ALL_VISIBLE_SESSION_LIST = HF_ALL_VISIBLE_SESSION_LIST.Substring(0, HF_ALL_VISIBLE_SESSION_LIST.Length - 1)
            End If
            If HF_SESSION_FACULTY_DATA <> "" Then
                HF_SESSION_FACULTY_DATA = HF_SESSION_FACULTY_DATA.Substring(0, HF_SESSION_FACULTY_DATA.Length - 1)
            End If

            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            row.Add("HF_ALL_VISIBLE_SESSION_LIST", HF_ALL_VISIBLE_SESSION_LIST)
            row.Add("HF_SESSION_FACULTY_DATA", HF_SESSION_FACULTY_DATA)
            row.Add("HF_TREE_SESSION_ALL_DATA", HF_TREE_SESSION_ALL_DATA)

            row.Add("graphdata", JsonConvert.SerializeObject(tree))



            rows.Add(row)

        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Get_SESSION_TREE_DATA" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Get_SESSION_TREE_DATA" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - Get_SESSION_TREE_DATA" + exce.Message)
            'LblError.Text = exce.Message
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - Get_SESSION_TREE_DATA" + expe.Message)
            'LblError.Text = expe.Message.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
            logger.Error("TrainingAPI - Get_SESSION_TREE_DATA" + ex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message_Front_end(Domain, IsOnline, ex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Get_SESSION_TREE_DATA" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        End Try
        Dim serializer As New JavaScriptSerializer
        serializer.MaxJsonLength = Integer.MaxValue
        Return serializer.Serialize(rows)
        'Return JsonConvert.DeserializeObject(jsonstr.ToString.Replace("'", ControlChars.Quote))
    End Function


End Class



