    Public Function ValidateUserData(certificate As X509Certificate2, DataBeforehash As String, hWcryptoSigneddata As String) As Boolean
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")

        Dim rsa As RSACryptoServiceProvider
        Dim x509 As X509Certificate2
        x509 = New X509Certificate2(certificate)
        Try

            rsa = TryCast(x509.PublicKey.Key, RSACryptoServiceProvider)

            If ((rsa.VerifyData(Encoding.UTF8.GetBytes(DataBeforehash), CryptoConfig.MapNameToOID("SHA256"), Convert.FromBase64String(hWcryptoSigneddata)) = True)) Then

                Return True
            Else
                Return False
            End If
        Catch ex As Exception
            logger.Error("TrainingAPI - ValidateUserData" + ex.Message)
        End Try
#Disable Warning BC42353 ' Function 'ValidateUserData' doesn't return a value on all code paths. Are you missing a 'Return' statement?
    End Function
#Enable Warning BC42353 ' Function 'ValidateUserData' doesn't return a value on all code paths. Are you missing a 'Return' statement?

    Public Function VerifyHash(certificatestring, plaintext, signdata)

        Dim cert As X509Certificate2 = GetCurrentUserCertificates(certificatestring)

        If ValidateUserData(cert, plaintext, signdata) = True Then

            Return True
        Else
            Return False
        End If
