    Public Function RCVP_DB_PrintNotesheet_Data(ByVal Domain As String, ByVal Isonline As String, ByVal TrainingId As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")

#Disable Warning BC42024 ' Unused local variable: 'period'.
        Dim trainingcode, t_details, Trainingcordinator, Department, period, ToDate,
 FromDate, TrainingFee, AsstDiractor, Duration, LevelofTraining, TranningProgram,
 year, TrainingDetails, Trainingdivision, chargedOfficer, Superintendent, assistant, JOINTDEPT_NAME, TraningType, TotalTrainee As String
#Enable Warning BC42024 ' Unused local variable: 'period'.

        Dim dsTrainingDetails As DataSet = dm.GetTrainingPlanDetails(Domain, Isonline, TrainingId, 0, 0)

        Dim dtTrainging_MST As DataTable = dsTrainingDetails.Tables(0)
        'Dim dtTrainging_SCH_CAT As DataTable = dsTrainingDetails.Tables(1)
        Dim dtTrainging_DTL As DataTable = dsTrainingDetails.Tables(2)
        Dim year1, year2 As Integer

        Dim dDate As DateTime = dtTrainging_MST.Rows(0).Item("T_Startdate").ToString
        If dDate.Month <= 3 Then
            year1 = dDate.Year - 1
            year2 = dDate.Year
        Else
            year1 = dDate.Year
            year2 = dDate.Year + 1
        End If
        year = year1 & "-" & year2


        Dim COURSEDIRECTORName As String = ""
