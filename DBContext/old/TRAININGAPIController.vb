                            If System.IO.File.Exists(Server.MapPath("~/Temp_Upload/" + dtsessionmaster.Rows(i)("ttsad_attach_path").ToString.Replace("~", ""))) Then
                                'System.IO.File.Move(Server.MapPath("~/Temp_Upload/" + img), Server.MapPath("~/Training_Upload/" + img))
                                ' System.IO.File.Copy(Server.MapPath("~/Temp_Upload/" + img), Server.MapPath("~/Training_Upload/" + img))
                                Dim sptfilename = dtsessionmaster.Rows(i)("ttsad_attach_path").ToString.Replace("~", "").Split(".")
                                newAttachmentpath = Guid.NewGuid.ToString + "." + sptfilename(1)
                                'System.IO.File.Create(Server.MapPath("~/Training_Upload/" + newAttachmentpath))
                                System.IO.File.Copy(Server.MapPath("~/Temp_Upload/" + dtsessionmaster.Rows(i)("ttsad_attach_path").ToString.Replace("~", "")), Server.MapPath("~/Temp_Upload/" + newAttachmentpath))

                            End If
                            dm.Save_Session_Attachment(Domain, IsOnline, cloneto_trgid, cloneto_trg_cat_id, sessionid, branchid, dtsessionmaster.Rows(i)("ttsad_title").ToString, dtsessionmaster.Rows(i)("ttsam_comp_type").ToString, dtsessionmaster.Rows(i)("GlobalContentyTypeID").ToString, Guid.NewGuid.ToString, newAttachmentpath, dtsessionmaster.Rows(i)("ttsad_attach_text").ToString, createdby, Nothing, "0", dtsessionmaster.Rows(i)("ttsad_tag").ToString, "1", usertype, loginempid, loginempid, dtsessionmaster.Rows(i)("GlobalFileName").ToString, dtsessionmaster.Rows(i)("GlobalContentFolderID").ToString, dtsessionmaster.Rows(i)("tdds_status").ToString, dtsessionmaster.Rows(i)("ttsam_globalcontentid").ToString)
                        Next

                    End If

                End If



                '***********************************





                row = New Dictionary(Of String, Object)()
                row.Add("status", "Success")
                rows.Add(row)
            Else
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", "Data not save try again")
                rows.Add(row)
