            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If
        Try
            Dim dtParam As New DataTable
            Dim dtXMLparam As New DataTable
            If Parameters IsNot Nothing Then
                dtParam = DerializeDataTable(Parameters)
            End If

            If XMLparam IsNot Nothing Then
                dtXMLparam = DerializeDataTable(XMLparam)
            End If

            If Not ImageParam Is Nothing Then
                Dim doctype = "jpeg"
                If Base64DocType <> "" Then
                    If (Base64DocType = "1") Then
                        doctype = "jpg"
                    ElseIf Base64DocType = "2" Then
                        doctype = "jpg"
                    ElseIf Base64DocType = "3" Then
                        doctype = "pdf"
                    ElseIf Base64DocType = "4" Then
                        doctype = "docx"
                    ElseIf Base64DocType = "5" Then
                        doctype = "xls"
                    ElseIf Base64DocType = "6" Then
                        doctype = "ppt"
                    ElseIf Base64DocType = "7" Then
                        doctype = "txt"

