        mailtext = mailtext.Replace("(#trgenddate#)", CDate(dttrgdetails.Rows(0)("T_ClosingDate").ToString()).ToString("dd/MM/yyyy"))



        'mailtext = Get_Trg_Detail_To_Mail(Domain, IsOnline, TrainingPlanID)
