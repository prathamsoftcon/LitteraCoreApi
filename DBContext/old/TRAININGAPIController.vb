    Private Function ADD_SPVoucherROW(ByVal DataTblSP As DataTable, ByVal VROWNO As Integer, ByVal ledgerid As String, ByVal AGENCYID As String, ByVal Categoryid As String, ByVal LEDGERTYPECOLUMNID As String, ByVal COLUMNVALUE As String) As DataTable
        Dim rowsp As DataRow
        rowsp = DataTblSP.NewRow()
        rowsp.Item("VROWNO") = VROWNO
        rowsp.Item("LEDGERID") = ledgerid
        If AGENCYID <> "" Then
            rowsp.Item("AGENCYID") = AGENCYID
        End If

        If Categoryid <> "" Then
            rowsp.Item("CATEGORYID") = Categoryid
        End If

        If LEDGERTYPECOLUMNID <> "" Then
            rowsp.Item("LEDGERTYPECOLUMNID") = LEDGERTYPECOLUMNID
        End If

        If COLUMNVALUE <> "" Then
            rowsp.Item("COLUMNVALUE") = COLUMNVALUE
        End If

        DataTblSP.Rows.Add(rowsp)
        Return DataTblSP

    End Function


