    Public Function Create_Thumbnail(ByVal ThumbnailPath As String, ByVal fromFolder As String, ByVal toFolder As String, ByVal documenttype As String)
        If documenttype = "4" Then
            Dim filename = Server.MapPath("~/" + fromFolder + "/" & ThumbnailPath)
            Dim outputname = Server.MapPath("~/" + toFolder + "/" & ThumbnailPath + "_thumb.jpg")
            Dim ffMpeg = New NReco.VideoConverter.FFMpegConverter()
            ffMpeg.GetVideoThumbnail(filename, outputname)
        ElseIf documenttype = "5" Then
            Dim filename = Server.MapPath("~/" + fromFolder + "/" & ThumbnailPath)
            Dim outputname = Server.MapPath("~/" + toFolder + "/" & ThumbnailPath + "_thumb.jpg")
            Dim image As Drawing.Image = Drawing.Image.FromFile(filename)
            Dim thumbimage = image.GetThumbnailImage(120, 120, Function() False, IntPtr.Zero)
            thumbimage.Save(outputname)
            'ElseIf documenttype = "1" Then
            '    Dim doc As New pdf.PdfDocument()
            '    doc = New Document()
            '    Dim page = doc.PageCount(1)

        End If



    End Function

