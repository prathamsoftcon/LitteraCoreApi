        mailtext = es.text


        Dim subject As String = ""

        subject = mailsubject.Replace("(#trgcode#)", "NAME" + " - " + "TPNO")
        subject = mailsubject.Replace("(#startdate#)", "SDATE")

        Dim dttrgdetails As DataTable = dm.Get_Trg_Data_New(Domain, isonline, trainingid).Tables(0)
        mailtext = mailtext.Replace("(#regname#)", "")
        mailtext = mailtext.Replace("(#trgname#)", dttrgdetails.Rows(0)("CourseName").ToString())
        mailtext = mailtext.Replace("(#trgcode#)", dttrgdetails.Rows(0)("TrainingCode").ToString())
        mailtext = mailtext.Replace("(#cdname#)", dttrgdetails.Rows(0)("CourseDirectorName").ToString())
        mailtext = mailtext.Replace("(#acdname#)", dttrgdetails.Rows(0)("AssociateDirectorName").ToString())
