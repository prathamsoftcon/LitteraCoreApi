            For DTLindex As Integer = 0 To dr.Length - 1
                With dr(DTLindex)
                    'commented due to it is giving wrong sum of participant of conduct trainings.
                    ' If .Item("Training_SponsorType") = 2 Then Continue For
                    ' Skip Joint DEPT CASE
                    POSTPONED_STATUS_TEXT = "--"
                    CONDUCT_STATUS_TEXT = "--"
                    CANCELLED_STATUS_TEXT = "--"
                    BALANCE_STATUS_TEXT = "--"
                    If .Item("TrainingStatus").ToString = "0" Then ' Balance
                        SC_BALANCE += 1
                        TC_BALANCE += 1
                        SCP_BALANCE += Val(.Item("noofparticipant").ToString)
                        TCP_BALANCE += Val(.Item("noofparticipant").ToString)
                        BALANCE_STATUS_TEXT = "REMAIN"
                    ElseIf .Item("TrainingStatus").ToString = "1" OrElse .Item("TrainingStatus").ToString = "4" Then
