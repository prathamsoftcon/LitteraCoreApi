    Private Function Checkcourse(ByVal Domain As String, ByVal isonline As String, ByVal coursename As String, ByVal Hcoursename As String, ByVal duration As String, ByVal durationtype As String, ByVal language As String, ByVal coursecategory As String) As String
        Dim msg As String = ""
        Dim isExiststype As Byte = 0
        Dim isExists As Boolean = False
        Dim dtCheckcourse As DataTable = dm.CheckCourse(Domain, isonline, Nothing, coursename.Trim, Hcoursename, Val(duration), Val(durationtype), coursecategory)
        If (Not dtCheckcourse Is Nothing) AndAlso dtCheckcourse.Rows.Count > 0 Then
            If CType(dtCheckcourse.Rows(0).Item("CourseCode").ToString, Boolean) = True Then
                isExists = True
                'LblError.Text &= ",Course Code"
                'Change by uttam (24/09/12)Task No: 1179
                If language = 1 Then
                    msg &= ",Course Name"
                Else
                    msg &= ",कोर्स कोड "
                End If
                isExiststype = 1
            End If
            If CType(dtCheckcourse.Rows(0).Item("CourseName").ToString, Boolean) = True Then
                isExists = True
                'LblError.Text &= ",Course Name "
                'Change by uttam (24/09/12)Task No: 1179
                If language = 1 Then
                    msg &= ",Course Name"
                Else
                    msg &= ",कोर्स नाम "
                End If
                isExiststype = 2
            End If
            If CType(dtCheckcourse.Rows(0).Item("HCourseName").ToString, Boolean) = True Then
                isExists = True
                'LblError.Text &= ",Course Name(Hindi) "
                'Change by uttam (24/09/12)Task No: 1179
                If language = 1 Then
                    msg &= ",Course Name (Hindi)"
                Else
                    msg &= ",कोर्स नाम (हिन्दी)"
                End If
                isExiststype = 2
            End If
            If isExists = True Then
                If isExiststype = 1 Then
                    'LblError.Text &= " already Exists "
                    'Change by uttam (24/09/12)Task No: 1179
                    If language = 1 Then
                        msg &= ",already Exists"
                    Else
                        msg &= ",पहले से मोजूद है ।"
                    End If
                Else
                    'LblError.Text &= " already Exists with this Duration and Duration Type"
                    'Change by uttam (24/09/12)Task No: 1179
                    If language = 1 Then
                        msg &= ",already Exists with this Duration and Duration Type"
                    Else
                        msg &= ",अवधि और अवधि का प्रकार पहले से मोजूद है ।"
                    End If
                End If

            End If
        End If
        If isExists = False Then
            msg = ""
        End If
        Return msg
    End Function

    Public Function Save_Course_Data(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal XMLparam As String, ByVal XMLName As String, ByVal CreatedOnParameter As String, ByVal Coursename As String, ByVal hcoursename As String, ByVal duration As String, ByVal durationtype As String, ByVal language As String, ByVal coursecatrgory As String, ByVal APIKEY As String)
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        If XMLparam = "" Then
            XMLparam = Nothing
        End If
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing
        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If
        Try
            Dim dtParam As New DataTable
            Dim dtXMLparam As New DataTable
            If Parameters IsNot Nothing Then
                dtParam = DerializeDataTable(Parameters)
            End If
            Dim returnstr = Checkcourse(Domain, IsOnline, Coursename, hcoursename, duration, durationtype, language, coursecatrgory)
            If (returnstr <> "") Then
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
