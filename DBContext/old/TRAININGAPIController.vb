                'jsstr = "{"
                For x = 0 To dt_trg_to_time_table.Rows.Count - 1
                    If dt_trg_to_time_table.Rows(x)("ttttt_status").ToString = "9" Then
                        Continue For
                    End If
                    If dt_trg_to_time_table.Rows(x)("ttttt_type").ToString <> "1" And dt_trg_to_time_table.Rows(x)("ttttt_type").ToString <> "2" Then
                        Continue For
                    End If

                    Dim tempstartdatetime As DateTime
                    tempstartdatetime = dt_trg_to_time_table.Rows(x)("ttttt_session_dt").ToString + " " + dt_trg_to_time_table.Rows(x)("ttttt_session_time").ToString
                    Dim tempenddatetime As DateTime
