            dtbilldetail.Columns.Add("headname")
            dtbilldetail.Columns.Add("hheadname")
            dtbilldetail.Columns.Add("Unitname")
            dtbilldetail.Columns.Add("HUnitname")
            dtbilldetail.Columns.Add("sponsorid")
            dtbilldetail.Columns.Add("sponsorname")
            dtbilldetail.Columns.Add("hsponsorname")
            dtbilldetail.Columns.Add("noofparticipant")
            dtbilldetail.Columns.Add("DueFees")
            dtbilldetail.Columns.Add("ReceivedFees")
            dtbilldetail.Columns.Add("totalprice")
            dtbilldetail.Columns.Add("taxrate")
            dtbilldetail.Columns.Add("taxableamount")
            dtbilldetail.Columns.Add("noofparticipant_registered")




            dsdata = dm.Get_Trg_Data_New(Domain, IsOnline, trainingid)

            dttrg = dsdata.Tables(0)
            dtexp = dsdata.Tables(1)
            dtsponsordetail = dsdata.Tables(2)
            Dim totalsponsorcount As Int16
            totalsponsorcount = dsdata.Tables(2).Rows.Count

            dtsponsordetail.DefaultView.RowFilter = "SPONSOR_AG_ID='" + sponsorid + "'"
            dtfiltersponsor = dtsponsordetail.DefaultView.ToTable

            dtparticipantdetail = dm.GET_TRG_DETAILS_BY_TRG(Domain, IsOnline, Nothing, Nothing, trainingid).Tables(0)


            dtparticipantdetail.DefaultView.RowFilter = "SPONSOR_AG_ID='" + sponsorid + "'"
            dtparticipantdetail = dtparticipantdetail.DefaultView.ToTable


            Dim dttaxrate As DataTable = dm.Get_Tax_Rates(Domain, IsOnline)

            Dim dr As DataRow
            For i = 0 To dttrg.Rows.Count - 1

                For j = 0 To dtexp.Rows.Count - 1
                    dr = dtbilldetail.NewRow
                    dr("TrainingId") = dttrg.Rows(i)("TrainingId").ToString
                    dr("t_name") = dttrg.Rows(i)("coursename").ToString
                    dr("TrainingCode") = dttrg.Rows(i)("TrainingCode").ToString
                    dr("Duration") = dttrg.Rows(i)("Duration").ToString
                    dr("DurationType") = dttrg.Rows(i)("DurationType").ToString
                    dr("T_StartDate") = dttrg.Rows(i)("T_StartDate").ToString
                    dr("T_ClosingDate") = dttrg.Rows(i)("T_ClosingDate").ToString
                    dr("headid") = dtexp.Rows(j)("T_ExpHeadId").ToString
                    dr("unitid") = dtexp.Rows(j)("T_UnitId").ToString
                    If dtexp.Rows(j)("T_UnitId").ToString = "00010" Then
                        dr("rate") = CDbl(dtexp.Rows(j)("T_Rate").ToString) / totalsponsorcount
                    Else
                        dr("rate") = dtexp.Rows(j)("T_Rate").ToString
                    End If



                    'Buniness rule to calculate quantity
                    Dim qty As Double = 0.00
                    If totalsponsorcount > 1 Then
                        qty = dtfiltersponsor.Rows(0)("reg_participant").ToString
                    Else
                        qty = dtexp.Rows(j)("t_actual_qty").ToString
                    End If

                    If dtexp.Rows(j)("T_UnitId").ToString = "00010" Then
                        If qty > 1 Then
                            qty = "1"
                        End If

                    End If


                    dr("quantity") = qty
                    dr("headname") = dtexp.Rows(j)("Expenditure").ToString
                    dr("hheadname") = dtexp.Rows(j)("HExpenditure").ToString
                    dr("Unitname") = dtexp.Rows(j)("Unit").ToString
                    dr("HUnitname") = dtexp.Rows(j)("HUnit").ToString
                    dr("sponsorid") = dtparticipantdetail.Rows(0)("SPONSOR_AG_ID").ToString
                    dr("sponsorname") = dtparticipantdetail.Rows(0)("SponsorName").ToString
                    dr("HSponsorName") = dtparticipantdetail.Rows(0)("HSponsorName").ToString
                    dr("DueFees") = dtparticipantdetail.Rows(0)("DueFees").ToString
                    dr("ReceivedFees") = dtparticipantdetail.Rows(0)("ReceivedFees").ToString
                    dr("NoOfParticipant") = dtparticipantdetail.Rows(0)("NoOfParticipants").ToString
                    dr("noofparticipant_registered") = dtparticipantdetail.Rows(0)("NoOfParticipants_Registered").ToString


                    Dim rate As Double = 0.00
                    Dim totalprice As Double = 0.00
                    If dtexp.Rows(j)("T_Rate").ToString <> "" Then
                        If dtexp.Rows(j)("T_UnitId").ToString = "00010" Then
                            rate = CDbl(dtexp.Rows(j)("T_Rate").ToString) / totalsponsorcount
                        Else
                            rate = CDbl(dtexp.Rows(j)("T_Rate").ToString)
                        End If


                    End If
                    'If dtfiltersponsor.Rows(0)("DeptwiseNoofparticipant").ToString <> "" Then
                    '    qty = CDbl(dtfiltersponsor.Rows(0)("DeptwiseNoofparticipant").ToString)
                    'End If

                    If dtexp.Rows(j)("T_UnitId").ToString = "00070" Then
                        totalprice = 1 * rate
                    Else
                        totalprice = qty * rate
                    End If


                    'totalprice = qty * rate
                    dr("totalprice") = totalprice.ToString
                    Dim dtfilterrate As DataTable
                    dttaxrate.DefaultView.RowFilter = "LedgerID='" + dtexp.Rows(j)("T_ExpHeadId").ToString + "'"
                    dtfilterrate = dttaxrate.DefaultView.ToTable
                    If dtfilterrate.Rows.Count > 0 Then
                        dr("taxrate") = dtfilterrate.Rows(0)("taxrate").ToString
                    Else
                        dr("taxrate") = "0"
                    End If

                    dr("taxableamount") = ((totalprice * 18) / 100).ToString

                    dtbilldetail.Rows.Add(dr)
                Next
            Next

            dtTableData = dtbilldetail

            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)
            If dtTableData.Rows.Count > 0 Then
                For i = 0 To dtTableData.Rows.Count - 1
