    Public Function Get_Login_Date_Time() As String
        Dim Createdon_New As String          '' To hold Createdon where time in 24 hours format.
        Dim SplitStartDate_New() As String  '' To hold split current date as array
        Dim T_StartDate_New As Date         '' To hold current date without time
        Dim Hours As Integer                '' To hold only hours of time.
        Dim Str As String = "00"            '' To hold value if time(Hour) in 12 AM
        Dim GetOnlyTime() As String         '' To hold split current Time as array

        SplitStartDate_New = Common.getDateTime.ToString.Split(" ")
        T_StartDate_New = SplitStartDate_New(0)
        If SplitStartDate_New.Length > 2 Then
            If SplitStartDate_New(2).ToString.ToUpper = "PM" Then
                GetOnlyTime = SplitStartDate_New(1).Split(":")
                Hours = Convert.ToInt32(GetOnlyTime(0))
                If Hours <> 12 Then
                    Hours = (12 + Hours)
                End If
                Createdon_New = (General.Get_DB_Date(T_StartDate_New.ToString("dd/MM/yyyy"))).ToString("dd/MM/yyyy") + " " + Convert.ToString(Hours) + ":" + GetOnlyTime(1) + ":" + GetOnlyTime(2)
            Else
                GetOnlyTime = SplitStartDate_New(1).Split(":")
                Hours = Convert.ToInt32(GetOnlyTime(0))
                Createdon_New = (General.Get_DB_Date(T_StartDate_New.ToString("dd/MM/yyyy"))).ToString("yyyy/MM/dd") + " " + Convert.ToString(Hours) + ":" + GetOnlyTime(1) + ":" + GetOnlyTime(2)
                If Hours = 12 Then
                    Createdon_New = (General.Get_DB_Date(T_StartDate_New.ToString("dd/MM/yyyy"))).ToString("dd/MM/yyyy") + " " + Str + ":" + GetOnlyTime(1) + ":" + GetOnlyTime(2)
                End If
            End If
        Else
            Createdon_New = (General.Get_DB_Date(T_StartDate_New.ToString("dd/MM/yyyy"))).ToString("dd/MM/yyyy") + " " + SplitStartDate_New(1)
        End If
        Return Createdon_New
    End Function




