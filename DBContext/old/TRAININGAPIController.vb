                Next
                'jsstr = "}"

                Dim objcls As New Littera.Util.IntersectingMeetings
                Dim isOverlap As Boolean = objcls.FindOverLap(meetingList1, meetingList2)

                If (isOverlap = True) Then
                    row = New Dictionary(Of String, Object)()
                    row.Add("status", "Error")
