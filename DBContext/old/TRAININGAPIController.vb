        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        If XMLparam = "" Then
            XMLparam = Nothing
        End If

        If basestring <> "" Then
            If SAVE_IMAGE_IN_FOLDER(basestring, imagename, folder) = False Then

            End If
        End If
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If

        Dim dtFrmRights As DataTable = dm.Get_Rights(Domain, IsOnline, Formroleid, Datamanager.TRG_TRAINING_PROPOSAL_FORM_ID, userid).Tables(0)
        If dtFrmRights.Rows.Count > 0 Then
            If CType(dtFrmRights.Rows(0).Item("InsertRight").ToString, Boolean) = False Then

                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                If language = "1" Then
                    row.Add("msg", "You Don't Have Rights.")
                Else
                    row.Add("msg", "आपको अधिकार नहीं है")
                End If
                rows.Add(row)
                Dim serializer1 As New JavaScriptSerializer
                serializer1.MaxJsonLength = Integer.MaxValue
                Return serializer1.Serialize(rows)

            End If
        Else

            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            If language = "1" Then
                row.Add("msg", "You Don't Have Rights.")
            Else
                row.Add("msg", "आपको अधिकार नहीं है")
            End If

            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If

        Try
            Dim dtParam As New DataTable
            Dim dtXMLparam As New DataTable
            If Parameters IsNot Nothing Then
                dtParam = DerializeDataTable(Parameters)
            End If

            'If XMLparam IsNot Nothing Then
            '    dtXMLparam = DerializeDataTable(XMLparam)
            'End If
            If proposalxml = "" Then
                If language = "1" Then
                    Throw New Exception("Please Add Proposal")
                Else
                    Throw New Exception("कृपया कम से कम एक प्रस्ताव जोडें")
                End If
                Exit Function
            End If


            Dim dtXml As New DataTable
            dtXml.Columns.Add("TRAININGTYPE")
            dtXml.Columns.Add("TRAININGDETAIL")
            dtXml.Columns.Add("TRAININGDAYS")
            dtXml.Columns.Add("NOOFPARTICIPANT")
            dtXml.Columns.Add("NOOFTRAINING")
            dtXml.Columns.Add("MONTHS")
            dtXml.Columns.Add("TRAININGYEAR")
            dtXml.Columns.Add("ISRESIDENTIAL")
            dtXml.Columns.Add("PER_TRG_COS")
            dtXml.Columns.Add("TOTAL_TRG_COST")
            dtXml.Columns.Add("FROMDATE")
            dtXml.Columns.Add("ENDDATE")
            dtXml.Columns.Add("LEVEL")
            dtXml.Columns.Add("TTPD_ID")
            dtXml.Columns.Add("TTPD_COURSE_ID")
            Dim dr As DataRow


            Dim sptdata() As String = proposalxml.Split("#")
            For i = 0 To sptdata.Length - 1
                If sptdata(i) = "" Then
                    Continue For
                End If
                Dim sptField() As String = sptdata(i).Split("*")
                dr = dtXml.NewRow
                dr("TTPD_ID") = sptField(0)
                dr("TRAININGTYPE") = sptField(2)
                dr("TRAININGDETAIL") = sptField(4).Replace("'", "")
                dr("TRAININGDAYS") = sptField(6)
                dr("NOOFPARTICIPANT") = sptField(8)
                dr("NOOFTRAINING") = sptField(9)
                If (sptField(12).ToString() <> "") Then
                    dr("MONTHS") = sptField(12).ToString().Replace("~", ",").Substring(0, sptField(12).ToString().Length - 1)
                Else
                    dr("MONTHS") = Nothing
                End If

                dr("TRAININGYEAR") = sptField(10)
                dr("ISRESIDENTIAL") = sptField(15)
                dr("PER_TRG_COS") = sptField(13)
                dr("TOTAL_TRG_COST") = sptField(14)


                If (sptField(18).ToString() <> "") Then
                    dr("FROMDATE") = Get_DB_Date(sptField(18).ToString()).ToString("yyyy/MM/dd")
                Else
                    dr("FROMDATE") = Nothing
                End If
                If (sptField(19).ToString() <> "") Then
                    dr("ENDDATE") = Get_DB_Date(sptField(19).ToString()).ToString("yyyy/MM/dd")
                Else
                    dr("ENDDATE") = Nothing
                End If
                dr("LEVEL") = sptField(20).ToString()

                If (sptField(17).ToString() <> "") Then
                    dr("TTPD_COURSE_ID") = sptField(17)
                Else
                    dr("TTPD_COURSE_ID") = Nothing
                End If
                dtXml.Rows.Add(dr)

            Next

            Dim xmldata As String = Nothing
            If dtXml.Rows.Count > 0 Then
                Dim wr As New StringWriter
                dtXml.TableName = "PROPOSALXML"
                dtXml.WriteXml(wr)
                xmldata = wr.ToString()
            End If

            Dim dtReturnstr As New DataTable
            Dim dtRef As DataTable = dm.Save_Proposal_Data(Domain, IsOnline, ProcedureName, dtParam, dtXMLparam, XMLName, CreatedOnParameter, xmldata)

            Dim subject As String
            subject = "Training Proposal " + dtRef.Rows(0)(0).ToString
            Dim MailText As String
            MailText = "Training Proposal Submitted Successfully,Your Reference  is:" + dtRef.Rows(0)(0).ToString
            If mobileno.ToString <> "" Then
                dm.sendOTPSms(mobileno, MailText)
            End If

            dm.Send_Mail(IsOnline, mailid, subject, MailText)

            If dtRef.Rows.Count > 0 Then
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Success")
                rows.Add(row)
                row = New Dictionary(Of String, Object)()
                row.Add("refno", dtRef.Rows(0)(0).ToString)
                rows.Add(row)
            Else
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", "Data not save try again")
                rows.Add(row)
            End If


        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Save_PROPOSAL_Data " + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
