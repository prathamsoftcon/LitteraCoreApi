    Public Function TRG_RESET_PASSWORD(ByVal Domain As String, ByVal IsOnline As String, ByVal userid As String, ByVal pvalue As String, ByVal type As String, ByVal oldpwd As String, ByVal username As String, ByVal agencytypeid As String, ByVal agencyid As String, ByVal APIKEY As String, ByVal plainpwd As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim sb As New StringBuilder
        Dim dtTableData As New DataTable
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing
        If TRG_CHECK_TOKEN(APIKEY) = False Then
