    Public Function RCVP_WORK_REPORT_ShowReport(ByVal Domain As String, ByVal IsOnline As String, ByVal Fromdate As String, ByVal AgencyID As String, ByVal AgencyName As String, ByVal APIKEY As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing
        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If
        Try

            Dim strRpt As New StringBuilder
            Dim dtreportDtl As DataTable = dm.GetWorkReport(Domain, IsOnline, Get_DB_Date(Fromdate).ToString("yyyy/MM/dd"))

            Dim dtList As Data.DataTable = dtreportDtl.DefaultView.ToTable
            dtList.DefaultView.RowFilter = "ExecutingAgencyid= '" & AgencyID & "'"
            dtList = dtList.DefaultView.ToTable

            Dim dtFilteredList As Data.DataTable = Nothing
            Dim dtFinalList As Data.DataTable = Nothing

            Dim iCount As Integer = 0 '



            strRpt.Append("<table style='font-family: 'Arial Unicode MS';   border: thin solid #000000; width: 800px' border='0' cellpadding='0' cellspacing='0'>")
            strRpt.Append("<tr style='font-size: 17px'>")

            strRpt.Append("<td align='center'>")
            strRpt.Append("दिनांक " & Fromdate & " से " & AgencyName & " को निर्माण कार्यो की स्वीकॄति जारी की सूची")
            strRpt.Append("</td>")
            strRpt.Append("</tr>")
            strRpt.Append("<tr style='font-size: 16px'>")

            strRpt.Append("<td align='center'>")
            strRpt.Append("(बीओजी द्वारा स्वीकॄत )")
            strRpt.Append("</td>")
            strRpt.Append("</tr>")
            strRpt.Append("<tr  >")
            strRpt.Append("<td>")


            strRpt.Append("<table style='font-family: 'Arial Unicode MS';   border: thin solid #000000; width: 800px' border='1' cellpadding='0' cellspacing='0'>")
            strRpt.Append("<tr style='font-size: 15px'>")

            If Me.Session("Choice") = 1 Then
                strRpt.Append("<td align='left'>S.No.</td>")
                strRpt.Append("<td align='left'>Work Name</td>")
                strRpt.Append("<td align='left'>Allotment No./ Allotment Date</td>")
                strRpt.Append("<td align='right'>Amount</td>")
                strRpt.Append("<td align='right'>Date</td>")
                strRpt.Append("<td align='right'>Deposit amount</td>")
                strRpt.Append("<td align='right'>Pending Amount</td>")
                strRpt.Append("<td align='left'>Remark</td>")

            Else
                strRpt.Append("<td align='left'>क्र०.</td>")
                strRpt.Append("<td align='left'>कार्य का नाम </td>")
                strRpt.Append("<td align='left'> प्रशासकीय स्वीकॄति क्र०./ जारी दिनांक</td>")

                strRpt.Append("<td align='Center'>राशि</td>")
                strRpt.Append("<td align='Center'> भुगतान का दिनांक</td>")
                strRpt.Append("<td align='Center'>भुगतान की गई राशि</td>")
                strRpt.Append("<td align='Center'>लंबित राशि</td>")
                strRpt.Append("<td align='left'>रिर्माक</td>")

            End If
            strRpt.Append("</tr>")

            Dim SNO As Integer = 0

            If dtList.Rows.Count > 0 Then
                dtList.DefaultView.Sort = "workgrpName ASC"

                iCount = dtList.DefaultView.ToTable(True, "workgrpName").Rows.Count
                dtFinalList = dtList.DefaultView.ToTable(True, "workgrpName")
                dtFinalList.DefaultView.Sort = "workgrpName"
                For iRowIndex As Integer = 0 To iCount - 1 '
                    Dim AAmt As Decimal = 0
                    Dim PAmt As Decimal = 0
                    Dim DAmt As Decimal = 0
                    Dim A_AMT_WorkGRoup As Decimal = 0
                    Dim D_AMT_WorkGRoup As Decimal = 0

                    strRpt.Append("<tr style='font-size: 15px'>")
                    strRpt.Append("<td align='left'> &nbsp; </td>")
                    strRpt.Append("<td align='left'> " & dtList.Rows(iRowIndex).Item("workgrpName").ToString & "</td>")
                    strRpt.Append("<td align='left'> &nbsp; </td>")
                    strRpt.Append("<td align='right'>&nbsp;</td>")
                    strRpt.Append("<td align='right'>&nbsp;</td>")
                    strRpt.Append("<td align='right'>&nbsp;</td>")
                    strRpt.Append("<td align='right'>&nbsp;</td>")
                    strRpt.Append("<td align='left'>&nbsp; </td>")
                    strRpt.Append("</tr>")

                    dtList.DefaultView.RowFilter = " workgrpName = '" & dtFinalList.Rows(iRowIndex)("workgrpName").ToString & "' "
                    dtFilteredList = dtList.DefaultView.ToTable

                    For i As Integer = 0 To dtFilteredList.Rows.Count - 1
                        With dtFilteredList.Rows(i)
                            If i > 0 Then
                                If .Item("workid").ToString <> dtFilteredList.Rows(i - 1).Item("workid").ToString Then
                                    DAmt = 0
                                    PAmt = 0
                                    A_AMT_WorkGRoup += Convert.ToDecimal(Val(.Item("AllotmentAmt").ToString))
                                    SNO += 1
                                    strRpt.Append("<tr style='font-size: 14px'>")
                                    strRpt.Append("<td align='left'>" & SNO & "</td>")
                                    strRpt.Append("<td align='left'>" & .Item("WorkName").ToString & "</td>")
                                    strRpt.Append("<td align='left'>" & .Item("AllotmentNo").ToString & " / " & CDate(.Item("AllotmentDate").ToString).ToString("dd.MM.yyyy") & "</td>")
                                Else
                                    strRpt.Append("<tr style='font-size: 14px'>")
                                    strRpt.Append("<td align='left'></td>")
                                    strRpt.Append("<td align='left'></td>")
                                    strRpt.Append("<td align='left'></td>")
                                End If
                            Else
                                A_AMT_WorkGRoup = Convert.ToDecimal(Val(.Item("AllotmentAmt").ToString))
                                SNO += 1
                                strRpt.Append("<tr style='font-size: 14px'>")
                                strRpt.Append("<td align='left'>" & SNO & "</td>")
                                strRpt.Append("<td align='left'>" & .Item("WorkName").ToString & "</td>")
                                strRpt.Append("<td align='left'>" & .Item("AllotmentNo").ToString & " / " & CDate(.Item("AllotmentDate").ToString).ToString("dd.MM.yyyy") & "</td>")
                            End If


                            strRpt.Append("<td align='right'>" & Val(.Item("AllotmentAmt").ToString) & "</td>")
                            If .Item("DepositDate").ToString = "" Then
                                strRpt.Append("<td align='right'></td>")
                            Else
                                strRpt.Append("<td align='right'>" & CDate(.Item("DepositDate").ToString).ToString("dd.MM.yyyy") & "</td>")
                            End If

                            strRpt.Append("<td align='right'>" & Val(.Item("DepositAmt").ToString) & "</td>")
                            AAmt = Convert.ToDecimal(.Item("AllotmentAmt").ToString)
                            DAmt += Convert.ToDecimal(Val(.Item("DepositAmt").ToString))
                            PAmt = AAmt - DAmt
                            strRpt.Append("<td align='right'>" & PAmt & "</td>")
                            strRpt.Append("<td align='left'>" & .Item("Remark").ToString & "</td>")
                            strRpt.Append("</tr>")

                            D_AMT_WorkGRoup += Convert.ToDecimal(Val(.Item("DepositAmt").ToString))


                        End With
                    Next

                    'sub total
                    strRpt.Append("<tr style='font-size: 15px'>")
                    strRpt.Append("<td align='left'> &nbsp; </td>")
                    strRpt.Append("<td align='left'> &nbsp; </td>")
                    strRpt.Append("<td align='left'> कुल राशि </td>")
                    strRpt.Append("<td align='right'>" & A_AMT_WorkGRoup & "</td>")
                    strRpt.Append("<td align='right'> &nbsp;</td>")
                    strRpt.Append("<td align='right'>" & D_AMT_WorkGRoup & "</td>")
                    strRpt.Append("<td align='right'>" & A_AMT_WorkGRoup - D_AMT_WorkGRoup & "</td>")
                    strRpt.Append("<td align='left'>&nbsp; </td>")
                    strRpt.Append("</tr>")


                Next
            End If

            strRpt.Append(" </table>")
            strRpt.Append("</td>")
            strRpt.Append("</tr>")
            Session("PrintSTR") = strRpt.ToString
            ' dvfeedback.InnerHtml = strRpt.ToString

            ' Dim popScript As String = "<script language='javascript' type='text/javascript'>window.open('../Training/NoteSheet.aspx?" & ENC_NAME_TrainingId & "=" & ENC_VALUE_TrainingId & "','_blank','addressbar=yes,resizable=yes,toolbar=no,status=no,menubar=no,location=center,scrollbars=yes,width=950,height=520')</script>"



            'btnPrint.Enabled = True

            'Page.RegisterStartupScript("popScript", popScript)

            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)


            row = New Dictionary(Of String, Object)()
            row.Add("PrintSTR", strRpt.ToString())
            rows.Add(row)


        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - RCVP_WORK_REPORT_ShowReport " + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - RCVP_WORK_REPORT_ShowReport " + exce.Message)
            'LblError.Text = exce.Message
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - RCVP_WORK_REPORT_ShowReport " + expe.Message)
            'LblError.Text = expe.Message.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
            logger.Error("TrainingAPI - RCVP_WORK_REPORT_ShowReport " + ex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message_Front_end(Domain, IsOnline, ex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        End Try



        Dim serializer As New JavaScriptSerializer
        Return serializer.Serialize(rows)

    End Function
