        Dim Dset As New DataSet
        Dim VoucherGuid As String = Nothing
        Dim BillType As Byte
        Dim sponsorBillGuid As String = Nothing
#Disable Warning BC42024 ' Unused local variable: 'rowSP'.
        Dim row, rowSP As DataRow
#Enable Warning BC42024 ' Unused local variable: 'rowSP'.
        Dim VoucherTy, Narr As String
        Dim Gtotal_DR, Gtotal_CR As Double
        Dim VRow_CR As Integer = 0
        Dim Vals As New Dictionary(Of String, Object)
        Dim DtVoucher As New DataTable
        Dim DataTblSP As New DataTable
        Dim dtLedgerTypeColumnId As New DataTable
        DtVoucher.Columns.Clear()
        DtVoucher.Columns.Add("VROWNO")
        DtVoucher.Columns.Add("LEDGERID")
        DtVoucher.Columns.Add("CATEGORYID")
        DtVoucher.Columns.Add("AGENCYTYPEID")
        DtVoucher.Columns.Add("AGENCYID")
        DtVoucher.Columns.Add("AMOUNTTYPE")
        DtVoucher.Columns.Add("AMOUNT")
        DtVoucher.Columns.Add("PHYSICALVALUEDR")
        DtVoucher.Columns.Add("PHYSICALVALUECR")
        DtVoucher.Columns.Add("CHEQUENO")
        DtVoucher.Columns.Add("BANKRECON")
        DtVoucher.Columns.Add("WORKPLANID")
        DtVoucher.Columns.Add("SANCTIONID")
        'datatable for column values
        DataTblSP.Columns.Add("VROWNO")
        DataTblSP.Columns.Add("LEDGERID")
        DataTblSP.Columns.Add("LEDGERTYPECOLUMNID")
        DataTblSP.Columns.Add("COLUMNVALUE")
        DataTblSP.Columns.Add("CATEGORYID")
        DataTblSP.Columns.Add("AGENCYID")
        VoucherTy = "Other"
        Narr = "BEING BILL SUBMITTED TO SPONSOR"
        'Hf_VoucherData=schemeid*categoryid*trainingid*trainingamount*Extraamt*sponsorid*billdate*trainingname
        Dim sptHiddenvoucherdata() As String = Hf_VoucherData.Split("~")
        Dim Subject, TrainingId, categoryid, TrainingFee As String
        For DRindex As Integer = 0 To sptHiddenvoucherdata.Length - 1
            If sptHiddenvoucherdata(DRindex) = "" Then
                Continue For
            End If
            Dim spthidvoucherfield() As String = sptHiddenvoucherdata(DRindex).Split("*")
            Subject = spthidvoucherfield(7)
            TrainingId = spthidvoucherfield(2)
            categoryid = spthidvoucherfield(1)
            TrainingFee = Val(spthidvoucherfield(3)) + Val(spthidvoucherfield(4))

            If TrainingFee <= 0 Then Continue For
            VRow_CR += 1
            row = DtVoucher.NewRow()
            row.Item("VROWNO") = VRow_CR
            row.Item("LEDGERID") = Datamanager.SUNDRY_DEBTORS_LEDGER
            row.Item("AGENCYID") = spthidvoucherfield(5)
            row.Item("AGENCYTYPEID") = "00053" 'SPONSORS
            row.Item("AMOUNTTYPE") = "DR"
            row.Item("AMOUNT") = TrainingFee
            DtVoucher.Rows.Add(row)
            Gtotal_DR += Val(TrainingFee)
            '/****************LedgerTypeColumns******************************/
            DataTblSP = FillCOlVALUEFOR_DR_New(Domain, isOnline, DataTblSP, VRow_CR, sponsorid, TrainingFee, TrainingId, billdate, Subject, branchid)
        Next
        '/****************CR******************************/
        For CRindex As Integer = 0 To sptHiddenvoucherdata.Length - 1

            If sptHiddenvoucherdata(CRindex) = "" Then
                Continue For
            End If
            Dim spthidvoucherfield() As String = sptHiddenvoucherdata(CRindex).Split("*")
            Subject = spthidvoucherfield(7)
            TrainingId = spthidvoucherfield(2)
            categoryid = spthidvoucherfield(1)
            TrainingFee = Val(spthidvoucherfield(3)) + Val(spthidvoucherfield(4))

            If TrainingFee <= 0 Then Continue For
            VRow_CR += 1
            row = DtVoucher.NewRow()
            row.Item("VROWNO") = VRow_CR
            row.Item("LEDGERID") = Datamanager.CONSULTANCY_INCOME_LEDGER
