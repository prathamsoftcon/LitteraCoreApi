    Private Function Checkcourse_For_Course_Master(ByVal Domain As String, ByVal isonline As String, ByVal coursename As String, ByVal Hcoursename As String, ByVal duration As String, ByVal durationtype As String, ByVal language As String, ByVal coursecategory As String, ByVal courseid As String) As String
        Dim msg As String = ""
        Dim isExiststype As Byte = 0
        Dim isExists As Boolean = False
        Dim dtCheckcourse As DataTable = dm.CheckCourse_New(Domain, isonline, Nothing, coursename.Trim, Hcoursename, Val(duration), Val(durationtype), coursecategory, courseid)
        If (Not dtCheckcourse Is Nothing) AndAlso dtCheckcourse.Rows.Count > 0 Then
            If CType(dtCheckcourse.Rows(0).Item("CourseCode").ToString, Boolean) = True Then
                isExists = True
                'LblError.Text &= ",Course Code"
                'Change by uttam (24/09/12)Task No: 1179
                If language = 1 Then
                    msg &= ",Course Name"
                Else
                    msg &= ",कोर्स कोड "
                End If
                isExiststype = 1
            End If
            If CType(dtCheckcourse.Rows(0).Item("CourseName").ToString, Boolean) = True Then
                isExists = True
                'LblError.Text &= ",Course Name "
                'Change by uttam (24/09/12)Task No: 1179
                If language = 1 Then
                    msg &= ",Course Name"
                Else
                    msg &= ",कोर्स नाम "
                End If
                isExiststype = 2
            End If
            If CType(dtCheckcourse.Rows(0).Item("HCourseName").ToString, Boolean) = True Then
                isExists = True
                'LblError.Text &= ",Course Name(Hindi) "
                'Change by uttam (24/09/12)Task No: 1179
                If language = 1 Then
                    msg &= ",Course Name (Hindi)"
                Else
                    msg &= ",कोर्स नाम (हिन्दी)"
                End If
                isExiststype = 2
            End If
            If isExists = True Then
                If isExiststype = 1 Then
                    'LblError.Text &= " already Exists "
                    'Change by uttam (24/09/12)Task No: 1179
                    If language = 1 Then
                        msg &= ",already Exists"
                    Else
                        msg &= ",पहले से मोजूद है ।"
                    End If
                Else
                    'LblError.Text &= " already Exists with this Duration and Duration Type"
                    'Change by uttam (24/09/12)Task No: 1179
                    If language = 1 Then
                        msg &= ",already Exists with this Duration and Duration Type"
                    Else
                        msg &= ",अवधि और अवधि का प्रकार पहले से मोजूद है ।"
                    End If
                End If

            End If
        End If
        If isExists = False Then
            msg = ""
        End If
        Return msg
    End Function

