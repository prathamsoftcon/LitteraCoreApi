    Public Function getreceiptwisebillamountXML_New(ByVal receiptHidden As String) As String
#Disable Warning BC42024 ' Unused local variable: 'dtReceiptwise'.
        Dim dtReceiptwise As DataTable
#Enable Warning BC42024 ' Unused local variable: 'dtReceiptwise'.
        ' Dim receiptHidden As String = "trainingid*extraid*receiptid*amt*chequeno*orgcheque#"
        Dim exphidden() As String = receiptHidden.Split("~")
        Dim dtReceiptwiseBillAmount As New DataTable
        dtReceiptwiseBillAmount.Columns.Add("TBDR_TRAININGID")
        dtReceiptwiseBillAmount.Columns.Add("TBDR_EXP_TRAININGID")
        dtReceiptwiseBillAmount.Columns.Add("TBDR_RECEIPTID")
        dtReceiptwiseBillAmount.Columns.Add("TBDR_AMOUNT")
        dtReceiptwiseBillAmount.Columns.Add("TBDR_CHEQUENO")

        Dim drow As DataRow
        If receiptHidden Is Nothing Then Return Nothing
        For i As Integer = 0 To exphidden.Length - 1
            If exphidden(i) = "" Then
                Continue For
            End If
            Dim sptdata() = exphidden(i).Split("*")


            If sptdata(2) <= 0 And sptdata(2) <> "" Then Continue For

            drow = dtReceiptwiseBillAmount.NewRow()


            drow.Item("TBDR_EXP_TRAININGID") = sptdata(0)
            drow.Item("TBDR_RECEIPTID") = sptdata(3)
            drow.Item("TBDR_AMOUNT") = Val(sptdata(2))

            If sptdata(4) <> "" Then
                drow.Item("TBDR_CHEQUENO") = sptdata(4)
            End If
            dtReceiptwiseBillAmount.Rows.Add(drow)
        Next

        Dim advancexml As String = Nothing
        Dim Wr As New System.IO.StringWriter
        If dtReceiptwiseBillAmount.Rows.Count > 0 Then
            dtReceiptwiseBillAmount.TableName = "ADVANCEAMOUNTXML"
            dtReceiptwiseBillAmount.WriteXml(Wr)
            advancexml = Wr.ToString()

        End If
        Return advancexml
    End Function

    Public Function getExpXML_New(ByVal exphidden As String) As String
        Dim ExpendXML As String = Nothing
        'Dim exphidden As String = "trainingid*expheadid*prposedamt*extraamt*advanceamt*count#"

        'Dim spthidden() As String = exphidden.Split("~")
        Dim spthidden() As String = exphidden.Split("~")
        Dim dt As New DataTable
        Dim dr As DataRow
        dt.Columns.Add("TRAININGID")
        dt.Columns.Add("EXPENDITUREHEADID")
        dt.Columns.Add("PROPOSEDAMOUNT")
        dt.Columns.Add("EXTRAAMOUNT")
        dt.Columns.Add("ADVANCEAMOUNT")


        For index As Integer = 0 To spthidden.Length - 1
            If spthidden(index) = "" Then
                Continue For
            End If
            Dim sptdata() As String = spthidden(index).Split("*")
            dr = dt.NewRow

            'If Val(sptdata(3)) = 0 AndAlso Val(sptdata(4) = 0) Then Continue For
            dr.Item("TRAININGID") = sptdata(0)
            dr.Item("EXPENDITUREHEADID") = sptdata(1)

#Disable Warning BC42025 ' Access of shared member, constant member, enum member or nested type through an instance; qualifying expression will not be evaluated.
            If sptdata(1) = dm.TRAINING_ADVANCELEDGERID Then
#Enable Warning BC42025 ' Access of shared member, constant member, enum member or nested type through an instance; qualifying expression will not be evaluated.
                dr.Item("PROPOSEDAMOUNT") = 0
                dr.Item("EXTRAAMOUNT") = 0
                dr.Item("ADVANCEAMOUNT") = sptdata(4)
            Else
                dr.Item("PROPOSEDAMOUNT") = sptdata(2)
                dr.Item("EXTRAAMOUNT") = sptdata(3)
                dr.Item("ADVANCEAMOUNT") = 0
            End If

            dt.Rows.Add(dr)
        Next



        Dim Wr As New System.IO.StringWriter
        If dt.Rows.Count > 0 Then
            dt.TableName = "EXPDETAILS"
            dt.WriteXml(Wr)
            ExpendXML = Wr.ToString()
        End If
        Return ExpendXML
    End Function



