    Private Function AddFacultyFeedback(ByVal drfacultyFeedback As DataRow) As String
        Dim sbtype3 As New StringBuilder
        If Not (drfacultyFeedback Is Nothing) Then
            sbtype3.Append("<td align='center'>")
            sbtype3.Append(drfacultyFeedback.Item("PercentagePerformance").ToString)
            sbtype3.Append("</td>")
        Else
            sbtype3.Append("<td align='center'>0</td>")
        End If
        Return sbtype3.ToString
    End Function


    Public Function RCVP_HONORAR_FillFaculty(ByVal Domain As String, ByVal IsOnline As String, ByVal language As String, ByVal APIKEY As String)
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If
        Try

            Dim dtFaculities As DataTable 'for holding datatable of faculty
            dtFaculities = dm.GET_FACULTY_DATA_NEW(Domain, IsOnline, Nothing)
            'Session("dtFaculities") = dtFaculities

            'If SearchFaculty = True Then
            '    Dim strSearchFaculty As String = txtfiltertm.Text
            '    If Me.Session("Choice") = 1 Then
            '        dtFaculities.DefaultView.RowFilter = "GuestFacultyName like '%" & strSearchFaculty & "%'"
            '    Else
            '        dtFaculities.DefaultView.RowFilter = "HGuestFacultyName like '%" & strSearchFaculty & "%'"
            '    End If
            '    dtFaculities = dtFaculities.DefaultView.ToTable
            'Else
            '    dtFaculities = Session("dtFaculities")
            'End If

            dtFaculities.DefaultView.RowFilter = Nothing
            dtFaculities = dtFaculities.DefaultView.ToTable
            If Session("Choice") = 1 Then
                dtFaculities.DefaultView.Sort = "GuestFacultyName"
            Else
                dtFaculities.DefaultView.Sort = "HGuestFacultyName"
            End If
            dtFaculities = dtFaculities.DefaultView.ToTable '(True, "GuestFacultyId", "GuestFacultyName")
            'ddlFaculty.Items.Clear()
            If dtFaculities.Rows.Count > 0 Then
                Dim litm As New WebControls.ListItem
                Dim TEXT As String
                litm.Value = "00000"
                If language = "1" Then
                    litm.Text = "ALL"
                Else
                    litm.Text = "सभी"

                End If
                'ddlFaculty.Items.Add(litm)
                For index As Integer = 0 To dtFaculities.Rows.Count - 1
                    If index > 1 Then
                        If (dtFaculities.Rows(index).Item("GuestFacultyId").ToString.ToUpper() =
                            dtFaculities.Rows(index - 1).Item("GuestFacultyId").ToString.ToUpper()) Then
                            Continue For
                        End If
                    End If
                    litm = New WebControls.ListItem

                    If language = "1" Then
