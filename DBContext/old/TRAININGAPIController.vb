                    End If
                Next
                If existdata = False Then
                    Continue For
                End If

                Dim dt As New DataTable
                dtTableData.DefaultView.RowFilter = "facultyid = '" + dtdistinctfaculty.Rows(i)("facultyid").ToString + "'"
