    Public Function Get_Week_No_Yearwise(ByVal crrdate As String) As String
        Dim dt As Date = CDate(crrdate)
        Return CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(dt, System.Globalization.CalendarWeekRule.FirstDay, DayOfWeek.Sunday)
    End Function
    Public Function Get_Week_No_FIN_Yearwise(ByVal crrdate As String) As String
        Dim finyeardate As String = CDate(crrdate).Year.ToString + "-04-01"
        Dim cuurentmonth As Int16 = CDate(crrdate).Month
        Dim weekonfinyear = CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(CDate(finyeardate), System.Globalization.CalendarWeekRule.FirstDay, DayOfWeek.Sunday)
        Dim minusval = Convert.ToInt16(weekonfinyear) - 1

        Dim dt As Date = CDate(crrdate)
        Dim retundata
        If Convert.ToInt16(cuurentmonth) >= 3 Then
            retundata = (Convert.ToInt16(CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(dt, System.Globalization.CalendarWeekRule.FirstDay, DayOfWeek.Sunday)) - minusval)
        Else
            retundata = (8 + Convert.ToInt16(weekonfinyear) + cuurentmonth)
        End If


        Return retundata
    End Function


