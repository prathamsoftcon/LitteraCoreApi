    Private Function GetSponsorColumnValXML(ByVal Domain As String, ByVal isOnline As String, ByVal usercode As String, ByVal sponsorname As String, ByVal Hsponsorname As String, ByVal address As String, ByVal pinno As String, ByVal departmenthead As String, ByVal phoneno As String, ByVal dept As String, ByVal Branchid As String, ByVal agencytypeid As String) As String
        Dim ColumnXML As String = ""
        Dim colid, ColValue, TypeColId As String
        Dim dtColumn, dtAgencyXML As DataTable
        With dm
#Disable Warning BC42104 ' Variable 'dtColumn' is used before it has been assigned a value. A null reference exception could result at runtime.
            dtColumn = .MakeDt(dtColumn, Datamanager.USERCODE_ColumnId, Datamanager.USERCODE_ColumnName, usercode)
#Enable Warning BC42104 ' Variable 'dtColumn' is used before it has been assigned a value. A null reference exception could result at runtime.
            If Not sponsorname.Trim = "" Then
                dtColumn = .MakeDt(dtColumn, Datamanager.FacultyName_ColumnId, Datamanager.FacultyName_ColumnName, sponsorname.ToUpper)
            End If

            If Not sponsorname.Trim = "" Then
                dtColumn = .MakeDt(dtColumn, Datamanager.FacultyHindiName_ColumnId, Datamanager.FacultyHindiName_ColumnName, Hsponsorname.ToUpper)
            End If
            dtColumn = .MakeDt(dtColumn, Datamanager.ADDRESS1_ColumnId, Datamanager.ADDRESS1_ColumnName, address.ToUpper)
            dtColumn = .MakeDt(dtColumn, Datamanager.PINCODE_ColumnId, Datamanager.PINCODE_ColumnName, pinno)
            dtColumn = .MakeDt(dtColumn, Datamanager.DEPT_HEAD_ColumnId, Datamanager.DEPT_HEAD_ColumnName, departmenthead.Trim)
            dtColumn = .MakeDt(dtColumn, Datamanager.PARMANENTPHONE_ColumnId, Datamanager.PARMANENTPHONE_ColumnName, phoneno.Trim)
            dtColumn = .MakeDt(dtColumn, Datamanager.DEPARTMENT_ColumnId, Datamanager.DEPARTMENT_ColumnId, dept.ToUpper)


            dtColumn = .MakeDt(dtColumn, Datamanager.LOCATION_ColumnId, Datamanager.LOCATION_ColumnName, Branchid)

            dtColumn = .MakeDt(dtColumn, Datamanager.LOCATION_TypeId, Datamanager.LOCATION_Type_ColumnName, agencytypeid)


            '************Fetching TypeColumn Id And Prepare Datatable for Xmlstorage
            GetTypeColumns(Domain, isOnline, "00053")
            For iRowindex As Integer = 0 To dtColumn.Rows.Count - 1
                colid = dtColumn.Rows(iRowindex).Item("COLUMNID")
                ColValue = dtColumn.Rows(iRowindex).Item("COLUMNVALUE").ToString
                TypeColId = GetTypeColumnID(colid)

                If TypeColId Is Nothing OrElse TypeColId.Trim = "" Then
                    '' Change By Ravi on 06.11.2012 For Manage Hindi Message Task No 1179
                    ''   Throw New Exception(" Column " & dtColumn.Rows(iRowindex).Item("COLUMNName") & " Not attached with this Agency Type.")
                    If Me.Session("Choice") = 0 Then
                        'Throw New Exception(" कॉलम  " & dtColumn.Rows(iRowindex).Item("COLUMNName") & " इस एजेंसी के प्रकार के साथ संलग्न नहीं है |")
                        Dim str = " कॉलम  " & dtColumn.Rows(iRowindex).Item("COLUMNName") & " इस एजेंसी के प्रकार के साथ संलग्न नहीं है |"
                        Throw New Exception(str)
                    Else
                        ' Throw New Exception(" Column " & dtColumn.Rows(iRowindex).Item("COLUMNName") & " Not attached with this Agency Type.")
                        Dim str = " Column " & dtColumn.Rows(iRowindex).Item("COLUMNName") & " Not attached with this Agency Type."
                        Throw New Exception(str)
                    End If
                End If
#Disable Warning BC42104 ' Variable 'dtAgencyXML' is used before it has been assigned a value. A null reference exception could result at runtime.
                dtAgencyXML = .MakeDataTableforXML(dtAgencyXML, TypeColId, ColValue)
#Enable Warning BC42104 ' Variable 'dtAgencyXML' is used before it has been assigned a value. A null reference exception could result at runtime.
            Next
        End With
        Dim sWriter As System.IO.StringWriter
        sWriter = New System.IO.StringWriter
        If dtAgencyXML.Rows.Count > 0 Then
            dtAgencyXML.TableName = "AgencyColumn"
            dtAgencyXML.WriteXml(sWriter)
            ColumnXML = sWriter.ToString
        End If
        Return ColumnXML
    End Function

