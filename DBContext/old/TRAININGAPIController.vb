    Public Function Get_TRG_FACULTY_DATA(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal TableIndex As Int16, ByVal ImageParam As String, ByVal APIKEY As String) As String
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")
        Dim sb As New StringBuilder
        Dim dsdata As DataSet
        Dim dtTableData As New DataTable
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing

        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If


        Try
            Dim dtColXML As DataTable
            If Parameters IsNot Nothing Then
                dtColXML = DerializeDataTable(Parameters)
            End If





#Disable Warning BC42104 ' Variable 'dtColXML' is used before it has been assigned a value. A null reference exception could result at runtime.
            dsdata = dm.Get_Common_Data(Domain, IsOnline, ProcedureName, dtColXML)
#Enable Warning BC42104 ' Variable 'dtColXML' is used before it has been assigned a value. A null reference exception could result at runtime.
            dtTableData = dsdata.Tables(TableIndex)



            '******************************Function To check Training Editable Bit************************


            row = New Dictionary(Of String, Object)()
            row.Add("status", "Success")
            rows.Add(row)


            dtTableData.Columns.Add("XDESIGNATION")
            dtTableData.Columns.Add("XCURRENTPOSTING")
            dtTableData.Columns.Add("XISBHOPAL")
            dtTableData.Columns.Add("XBRIEFDESC")
            For i = 0 To dtTableData.Rows.Count - 1
                Dim dtfilter As New DataTable
                If dtTableData.Rows(i)("tyaam_val").ToString <> "" Then
                    Dim xmlstr As String = dtTableData.Rows(i)("tyaam_val").ToString
                    Dim dS_specific_xml_data As New DataSet
                    Dim dt_specific_xml_data As New DataTable
                    Dim sr As New StringReader(xmlstr)
                    dS_specific_xml_data.ReadXml(sr)
                    dt_specific_xml_data = dS_specific_xml_data.Tables(0)
                    If dt_specific_xml_data.Columns.Contains("DESIGNATION") Then
                        dtTableData.Rows(i)("XDESIGNATION") = dt_specific_xml_data.Rows(0)("DESIGNATION").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("CURRENTPOSTING") Then
                        dtTableData.Rows(i)("XCURRENTPOSTING") = dt_specific_xml_data.Rows(0)("CURRENTPOSTING").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("ISBHOPAL") Then
                        dtTableData.Rows(i)("XISBHOPAL") = dt_specific_xml_data.Rows(0)("ISBHOPAL").ToString
                    End If
                    If dt_specific_xml_data.Columns.Contains("BRIEFDESC") Then
                        dtTableData.Rows(i)("XBRIEFDESC") = dt_specific_xml_data.Rows(0)("BRIEFDESC").ToString
                    End If

                End If
            Next



            If dtTableData.Rows.Count > 0 Then
                For i = 0 To dtTableData.Rows.Count - 1
                    row = New Dictionary(Of String, Object)()
                    For j = 0 To dtTableData.Columns.Count - 1
                        If dtTableData.Columns(j).ColumnName.ToString.ToUpper = "TTPAI_TRG_START_DATE" Or dtTableData.Columns(j).ColumnName.ToString.ToUpper = "TTPAI_TRG_END_DATE" Then
                            If dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString() <> "" Then
                                row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), CDate(dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString()).ToString("yyyy/MM/dd"))
                            Else
                                row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString())
                            End If
                        Else
                            row.Add(dtTableData.Columns(j).ColumnName.ToString().ToLower(), dtTableData.Rows(i)(dtTableData.Columns(j).ColumnName.ToString()).ToString())
                        End If


                    Next
                    rows.Add(row)
                Next
            End If
        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - Get_DATA_WITH_XML" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Get_DATA_WITH_XML" + exp.Message)
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - Get_DATA_WITH_XML" + exce.Message)
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - Get_DATA_WITH_XML" + expe.Message)
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
            logger.Error("TrainingAPI - Get_DATA_WITH_XML" + ex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message_Front_end(Domain, IsOnline, ex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - Get_DATA_WITH_XML" + exp.Message)
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        End Try
        Dim serializer As New JavaScriptSerializer
        serializer.MaxJsonLength = Integer.MaxValue
        Return serializer.Serialize(rows)
    End Function


