    Private Function getSponsorXML(ByVal Sponsor As String) As String
        Dim dtSponsors As New DataTable
        Dim drsponsor As DataRow
        Dim sptHid() As String = Sponsor.Split("#")
        dtSponsors.Columns.Add("DEPARTMENTID")
        dtSponsors.Columns.Add("NOOFPARTICIPANT")
        For index As Integer = 0 To sptHid.Length - 1
            If (sptHid(index) = "") Then
                Continue For
            End If
            Dim sptField() As String = sptHid(index).Split("*")
            drsponsor = dtSponsors.NewRow
            drsponsor.Item("DEPARTMENTID") = sptField(0)
            drsponsor.Item("NOOFPARTICIPANT") = sptField(2)
            dtSponsors.Rows.Add(drsponsor)

        Next
        Dim Wr As New System.IO.StringWriter
        Dim sponsorxml As String = Nothing
        If dtSponsors.Rows.Count > 0 Then
            dtSponsors.TableName = "T_DEPT"
            dtSponsors.WriteXml(Wr)
            sponsorxml = Wr.ToString()
        End If
        Return sponsorxml
    End Function
    Private Function GetTrainingExpendXML(ByVal TrainingPlanID As String, ByVal expendituretype As String, ByVal sponsoramt As String, ByVal exphidden As String) As String
        Dim ExpendXML As String = Nothing
        Dim dtSanction As New DataTable
        Dim drSanction As DataRow
        dtSanction.Columns.Add("TrainingId")
        dtSanction.Columns.Add("ExpendId")
        dtSanction.Columns.Add("UnitId")
        dtSanction.Columns.Add("Rate")
        dtSanction.Columns.Add("Quant")
        dtSanction.Columns.Add("S_RIGHT")

        If expendituretype = "1" Then
            drSanction = dtSanction.NewRow
            drSanction.Item("TrainingId") = TrainingPlanID
            drSanction.Item("ExpendId") = "3B264D36-E564-4460-B82F-5EC6B61C2BC4"
            drSanction.Item("UnitId") = "00006"
            drSanction.Item("Rate") = sponsoramt
            drSanction.Item("Quant") = 1
            drSanction.Item("S_RIGHT") = Nothing
            dtSanction.Rows.Add(drSanction)

        Else
            Dim spthid() As String = exphidden.Split("#")

            For index As Integer = 0 To spthid.Length - 1
                If (spthid(index) = "") Then
                    Continue For
                End If

                Dim sptField() As String = spthid(index).Split("*")

                drSanction = dtSanction.NewRow
                drSanction.Item("TrainingId") = TrainingPlanID
                drSanction.Item("ExpendId") = sptField(0)
                drSanction.Item("UnitId") = sptField(2)
                drSanction.Item("Rate") = sptField(4)
                drSanction.Item("Quant") = sptField(5)
                drSanction.Item("S_RIGHT") = Nothing
                dtSanction.Rows.Add(drSanction)
            Next


        End If



        Dim Wr As New System.IO.StringWriter

        If dtSanction.Rows.Count > 0 Then
            dtSanction.TableName = "temp"
            dtSanction.WriteXml(Wr)
            ExpendXML = Wr.ToString()
        End If
        Return ExpendXML
    End Function

    Private Function GetTrainingDisbursementXML(ByVal TrainingPlanID As String, ByVal schemeid As String, ByVal categoryid As String, ByVal sponsoramt As String) As String
        Dim DtDisburse As New DataTable
        Dim Drow As DataRow
        DtDisburse.Columns.Add("TrainingId")
        DtDisburse.Columns.Add("SchemeId")
        DtDisburse.Columns.Add("CategoryId")
        DtDisburse.Columns.Add("Own")
        DtDisburse.Columns.Add("Other")
        DtDisburse.Columns.Add("Subsidy")
        DtDisburse.Columns.Add("Ins1")
        DtDisburse.Columns.Add("Ins2")
        DtDisburse.Columns.Add("Final")
        Drow = DtDisburse.NewRow
        Drow.Item("TrainingId") = TrainingPlanID
        Drow.Item("SchemeId") = schemeid
        Drow.Item("CategoryId") = categoryid
        Drow.Item("Own") = "0.0"
        Drow.Item("Other") = "0.0"
        Drow.Item("Subsidy") = Val(sponsoramt)
        Drow.Item("Ins1") = "0.0"
        Drow.Item("Ins2") = "0.0"
        Drow.Item("Final") = Val(sponsoramt) '"0.0"

        DtDisburse.Rows.Add(Drow)
        Dim TrainingDisbursementXML As String = Nothing
        Dim wr As New System.IO.StringWriter
        If DtDisburse.Rows.Count > 0 Then
            DtDisburse.TableName = "temp2"
            DtDisburse.WriteXml(wr)
            TrainingDisbursementXML = wr.ToString()
        End If
        Return TrainingDisbursementXML
    End Function

