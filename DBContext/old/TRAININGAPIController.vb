    Private Function add_total_row(ByVal dtexp_total As DataTable, ByVal Trainingtotal As Double) As String
        Dim sbtotal As New StringBuilder
        Dim actualtotal As Double = 0
        Dim notionaltotal As Double = 0
        Dim ledgerid As String
        For i As Integer = 6 To 29
            If i = 6 Then
                ledgerid = Datamanager.LEDGER_HONORARIUM_EXPENCES
            ElseIf i = 7 Then
                'ledgerid = General.LEDGER_WORKING_LUNCH
                ledgerid = Datamanager.LEDGER_CLASS_ROOM_REFRESHMENT

            ElseIf i = 8 Then
                'ledgerid = General.LEDGER_CLASS_ROOM_REFRESHMENT

                ledgerid = Datamanager.LEDGER_PHOTO_SESSION
            ElseIf i = 9 Then
                'ledgerid = General.LEDGER_TRAVEL_ALLOWANCE
                ledgerid = Datamanager.LEDGER_OTHER_EXPENDITURE

            ElseIf i = 10 Then
                'ledgerid = General.LEDGER_INAUGRATION_SESSION
                ledgerid = Datamanager.LEDGER_FOLDER_PEN_WRITING_PAD

            ElseIf i = 11 Then
                ' ledgerid = General.LEDGER_VALIDATION_SESSION
                ledgerid = Datamanager.LEDGER_READING_MATERIAL
            ElseIf i = 12 Then
                'ledgerid = General.LEDGER_PHOTO_SESSION
                ledgerid = Datamanager.LEDGER_CLERICAL_EXPENSES

            ElseIf i = 13 Then
                ' ledgerid = General.LEDGER_LOCAL_TRAVELLING_EXPENDITURE
                ledgerid = Datamanager.LEDGER_FIELD_VISIT

            ElseIf i = 14 Then
                'ledgerid = General.LEDGER_OTHER_EXPENDITURE
                ledgerid = Datamanager.LEDGER_CLASS_ROOM_ELECTRICITY_WATER
            ElseIf i = 16 Then
                'ledgerid = General.LEDGER_FOLDER_PEN_WRITING_PAD

                ledgerid = Datamanager.LEDGER_EQUIPMENT_CHARGES
            ElseIf i = 17 Then
                ' ledgerid = General.LEDGER_FIELD_VISIT
                ledgerid = Datamanager.LEDGER_PHOTOCOPY_EXPENSES
            ElseIf i = 18 Then
                'ledgerid = General.LEDGER_READING_MATERIAL
                ledgerid = Datamanager.LEDGER_LIBRARY_CHARGES

            ElseIf i = 19 Then
                'ledgerid = General.LEDGER_PHOTOCOPY_EXPENSES
                ledgerid = Datamanager.LEDGER_OTHER_OVERHEAD_CHARGES
            ElseIf i = 20 Then
                ' ledgerid = General.LEDGER_CLASS_ROOM_ELECTRICITY_WATER
                ledgerid = Datamanager.LEDGER_CLOTH_WASHIG_EXPENSES

            ElseIf i = 21 Then
                'ledgerid = General.LEDGER_CLERICAL_EXPENSES
                ledgerid = Datamanager.LEDGER_HOSTEL_MAINTENANCE
            ElseIf i = 22 Then
                'ledgerid = General.LEDGER_LIBRARY_CHARGES
                ledgerid = Datamanager.LEDGER_SPORTS_EXP
            ElseIf i = 23 Then
                ' ledgerid = General.LEDGER_EQUIPMENT_CHARGES
            ElseIf i = 24 Then
                'ledgerid = General.LEDGER_OTHER_OVERHEAD_CHARGES
            ElseIf i = 25 Then
                'ledgerid = General.LEDGER_CLOTH_WASHIG_EXPENSES
            ElseIf i = 26 Then
                'ledgerid = General.LEDGER_HOSTEL_MAINTENANCE
            End If
            sbtotal.Append("<th align ='right' >")

            If i < 15 Then
#Disable Warning BC42104 ' Variable 'ledgerid' is used before it has been assigned a value. A null reference exception could result at runtime.
                sbtotal.Append(Val(dtexp_total.Select("ledgerid='" & ledgerid & "'")(0).Item("amt").ToString))
#Enable Warning BC42104 ' Variable 'ledgerid' is used before it has been assigned a value. A null reference exception could result at runtime.
                actualtotal += Val(dtexp_total.Select("ledgerid='" & ledgerid & "'")(0).Item("amt").ToString)

                'sbtotal.Append(Val(1000))
                'actualtotal += Val(1000)

            ElseIf i = 15 Then
                sbtotal.Append(actualtotal)
                'ElseIf i > 15 And i < 27 Then
            ElseIf i > 15 And i < 23 Then

                sbtotal.Append(Val(dtexp_total.Select("ledgerid='" & ledgerid & "'")(0).Item("amt").ToString))
                notionaltotal += Val(dtexp_total.Select("ledgerid='" & ledgerid & "'")(0).Item("amt").ToString)
            ElseIf i = 27 Then
                sbtotal.Append(notionaltotal)
            ElseIf i = 28 Then
                sbtotal.Append(actualtotal + notionaltotal)
            ElseIf i = 29 Then
                sbtotal.Append(Trainingtotal - (actualtotal + notionaltotal))
            End If

            sbtotal.Append("</th>")

        Next
        Return sbtotal.ToString

    End Function

