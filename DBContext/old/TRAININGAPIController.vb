    Private Function GetEXP_AMT_NEW(ByVal TrainingPlanID As String, ByVal expendituretype As String, ByVal sponsoramt As String, ByVal exphidden As String) As String
        Dim expamt As Decimal = 0.00


        Dim spthid() As String = exphidden.Split("#")

        For index As Integer = 0 To spthid.Length - 1
            If (spthid(index) = "") Then
                Continue For
            End If

            Dim sptField() As String = spthid(index).Split("*")

            expamt = expamt + (Convert.ToDecimal(sptField(4)) * Convert.ToDecimal(sptField(5)))

        Next

        Return expamt.ToString
    End Function


