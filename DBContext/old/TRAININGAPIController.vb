            dtTableData.Columns.Add("XIFSC")
            dtTableData.Columns.Add("XACCOUNTNO")


            'Filter to Merge Same Sponsor Row Amount and Participant count
            dtTableData.Columns.Add("Deletedrow")
            Dim exitstingData As List(Of String) = New List(Of String)
            For i = 0 To dtTableData.Rows.Count - 1
                Dim dtfilter As New DataTable
                If (exitstingData.Contains(dtTableData.Rows(i)("guestfacultyid").ToString)) Then
                    dtTableData.Rows(i)("Deletedrow") = "1"
