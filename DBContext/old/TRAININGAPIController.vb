            Return serializer1.Serialize(rows)
        End If

        Try

            Dim dDate As Date = Common.getDateTime
            Dim year As Int16
            Dim finyear As String = Financialyear
            If dDate.Month <= 3 Then
                year = CInt(finyear.Split("-")(1).ToString)
            Else
                year = CInt(finyear.Split("-")(0).ToString)
            End If
            If periodtype <> "6" Then
                dDate = General.Get_DB_Date(dDate.Day & "/" & dDate.Month & "/" & year)
            End If
            Dim iDaysInMonth As Integer
            Dim fromdate, todate As Date
            If periodtype = "1" Then
                fromdate = dDate.AddDays(-1)
                todate = dDate
            ElseIf periodtype = "2" Then
                fromdate = dDate
                todate = dDate.AddDays(+1)
            ElseIf periodtype = "3" Then
                '--------Get Date of Firstday of week
                If dDate.DayOfWeek = System.DayOfWeek.Sunday Then
                    fromdate = dDate
                ElseIf dDate.DayOfWeek = System.DayOfWeek.Monday Then
                    fromdate = dDate.AddDays(-1)
                ElseIf dDate.DayOfWeek = System.DayOfWeek.Tuesday Then
                    fromdate = dDate.AddDays(-2)
                ElseIf dDate.DayOfWeek = System.DayOfWeek.Wednesday Then
                    fromdate = dDate.AddDays(-3)
                ElseIf dDate.DayOfWeek = System.DayOfWeek.Thursday Then
                    fromdate = dDate.AddDays(-4)
                ElseIf dDate.DayOfWeek = System.DayOfWeek.Friday Then
                    fromdate = dDate.AddDays(-5)
                ElseIf dDate.DayOfWeek = System.DayOfWeek.Saturday Then
                    fromdate = dDate.AddDays(-6)
                End If
                '--------end---------------------
                todate = fromdate.AddDays(+7)
            ElseIf periodtype = "4" Then

                If dDate.Date > General.Get_DB_Date("15/" & dDate.Month & "/" & dDate.Year) Then
                    fromdate = General.Get_DB_Date("16/" & dDate.Month & "/" & dDate.Year)
                    todate = fromdate.AddDays(+15)
                Else
                    fromdate = General.Get_DB_Date("01/" & dDate.Month & "/" & dDate.Year)
                    todate = fromdate.AddDays(+15)
                End If
            ElseIf periodtype = "5" Then
                iDaysInMonth = DateTime.DaysInMonth(dDate.Year, dDate.Month)
                'fromdate = dDate.Month & "/01/" & dDate.Year
                fromdate = General.Get_DB_Date("01/" & dDate.Month & "/" & dDate.Year)
                todate = fromdate.AddDays(+iDaysInMonth - 1)
            ElseIf periodtype = "6" Then

                fromdate = General.Get_DB_Date("01" & "/04/" & (CInt(finyear.Split("-")(0).ToString)))
                todate = General.Get_DB_Date("31" & "/03/" & CInt(finyear.Split("-")(1).ToString))
            Else
                fromdate = General.Get_DB_Date("01" & "/04/" & (CInt(finyear.Split("-")(0).ToString)))
