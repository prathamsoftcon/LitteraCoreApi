    Private Function CDwiseDetail_Summary_NEW(ByVal Domain As String, ByVal isonline As String, ByVal sponsorid As String, ByVal cdid As String, ByVal StatusreportOrder As String, ByVal fromdate As String, ByVal todate As String, ByVal FinYear As String, ByVal Reportby As String, ByVal Language As String, ByVal sponsortypeid As String, ByVal trainingid As String, ByVal trgcode As String) As String
        Dim dtTrainingStatus_DTL As DataTable
        dtTrainingStatus_DTL = dm.GetTrainingStatus(Domain, isonline, Nothing, Nothing, 1, fromdate, todate)
        If trainingid.ToString <> "" Then
            dtTrainingStatus_DTL.DefaultView.RowFilter = "t_name like '%" + trainingid + "%'"
            dtTrainingStatus_DTL = dtTrainingStatus_DTL.DefaultView.ToTable
        End If
        If trgcode.ToString <> "" Then
            dtTrainingStatus_DTL.DefaultView.RowFilter = "trainingcode like '%" + trgcode + "%'"
