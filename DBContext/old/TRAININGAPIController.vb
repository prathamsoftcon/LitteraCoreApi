    'Added by sarvjeet on 18.06.2018 to create new save function for Requisition Slip For Electronic Item page(Training_Transaction/frm_requisition_electronic_equipment.aspx)
    Public Function RCVP_Rq_Slip_For_ElecItem_Save_Data(ByVal Domain As String, ByVal IsOnline As String, ByVal ProcedureName As String, ByVal Parameters As String, ByVal XMLparam As String, ByVal XMLName As String, ByVal CreatedOnParameter As String, ByVal ImageParam As String, ByVal Folder_Name As String, ByVal Base64DocType As String, ByVal APIKEY As String, ByVal reqDate As String, ByVal trgName As String, ByVal expDate As String, ByVal description As String, ByVal Formroleid As String, ByVal userid As String, ByVal language As String)
        Dim logger As ILog = log4net.LogManager.GetLogger("ErrorLog")

        If XMLparam = "" Then
            XMLparam = Nothing
        End If
        Dim rows As New List(Of Dictionary(Of String, Object))()
        Dim row As Dictionary(Of String, Object) = Nothing
        If TRG_CHECK_TOKEN(APIKEY) = False Then
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", "You Are Using Old Version ! Please Uninstall & Re-install New Version From Play Store")
            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If

        Dim dtFrmRights As DataTable = dm.Get_Rights(Domain, IsOnline, Formroleid, Datamanager.TRG_REQSLIP_FOR_ELEC_ITEM_FORM_ID, userid).Tables(0)
        If dtFrmRights.Rows.Count > 0 Then
            If CType(dtFrmRights.Rows(0).Item("InsertRight").ToString, Boolean) = False Then

                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                If language = "1" Then
                    row.Add("msg", "You Don't Have Rights.")
                Else
                    row.Add("msg", "आपको अधिकार नहीं है")
                End If
                rows.Add(row)
                Dim serializer1 As New JavaScriptSerializer
                serializer1.MaxJsonLength = Integer.MaxValue
                Return serializer1.Serialize(rows)

            End If
        Else

            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            If language = "1" Then
                row.Add("msg", "You Don't Have Rights.")
            Else
                row.Add("msg", "आपको अधिकार नहीं है")
            End If

            rows.Add(row)
            Dim serializer1 As New JavaScriptSerializer
            serializer1.MaxJsonLength = Integer.MaxValue
            Return serializer1.Serialize(rows)
        End If

        Try
            If reqDate = "" Then
                If language = "1" Then
                    Throw New Exception("Enter Requisition Date")
                Else
                    Throw New Exception("मांग दिनांक भरें")
                End If
                Exit Function
            ElseIf trgName = "00000" Or trgName = "" Then
                If language = "1" Then
                    Throw New Exception("Select Training Name")
                Else
                    Throw New Exception("प्रशिक्षण का नाम चुनें")
                End If
                Exit Function
            ElseIf expDate = "" Then
                If language = "1" Then
                    Throw New Exception("Enter Expected Delivery Date")
                Else
                    Throw New Exception("संभावित वितरण दिनांक भरें")
                End If
                Exit Function
            ElseIf description = "" Then
                If language = "1" Then
                    Throw New Exception("Enter Description")
                Else
                    Throw New Exception("विवरण भरें")
                End If
                Exit Function

            End If

            Dim dtParam As New DataTable
            Dim dtXMLparam As New DataTable
            If Parameters IsNot Nothing Then
                dtParam = DerializeDataTable(Parameters)
            End If

            If XMLparam IsNot Nothing Then
                dtXMLparam = DerializeDataTable(XMLparam)
            End If

            If Not ImageParam Is Nothing Then
                Dim doctype = "jpeg"
                If Base64DocType <> "" Then
                    If (Base64DocType = "1") Then
                        doctype = "jpg"
                    ElseIf Base64DocType = "2" Then
                        doctype = "jpg"
                    ElseIf Base64DocType = "3" Then
                        doctype = "pdf"
                    ElseIf Base64DocType = "4" Then
                        doctype = "docx"
                    ElseIf Base64DocType = "5" Then
                        doctype = "xls"
                    ElseIf Base64DocType = "6" Then
                        doctype = "ppt"
                    ElseIf Base64DocType = "7" Then
                        doctype = "txt"

                    End If
                End If



                For i = 0 To dtParam.Rows.Count - 1
                    If dtParam.Rows(i)(ImageParam).ToString <> "" Then
                        Dim bytess() As Byte = Convert.FromBase64String(dtParam.Rows(i)(ImageParam).ToString)
                        Dim imagename1 As String = Guid.NewGuid().ToString() + "." + doctype
                        Dim imagePath1 As String = Server.MapPath("~/" + Folder_Name + "/" + imagename1 + "")
                        Using imagefile As FileStream = New FileStream(imagePath1, FileMode.Create)
                            imagefile.Write(bytess, 0, bytess.Length)
                            imagefile.Flush()
                        End Using
                        dtParam.Rows(i)(ImageParam) = Folder_Name + "/" + imagename1 + ""
                    End If
                Next




                '
            End If
            Dim dtorderno As New DataTable
            dtorderno = dm.Save_Data_REF(Domain, IsOnline, ProcedureName, dtParam, dtXMLparam, XMLName, CreatedOnParameter)
            row = New Dictionary(Of String, Object)
            If dtorderno.Rows.Count > 0 Then
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Success")
                row.Add("orderno", dtorderno.Rows(0)(0).ToString())
                rows.Add(row)
            Else
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", "Data not save try again")
                rows.Add(row)
            End If



        Catch sqlex As SqlException ''''part to handle sql exceptions
            logger.Error("TrainingAPI - RCVP_Rq_Slip_For_ElecItem_Save_Data" + sqlex.Message)
            Try
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", dm.Show_Error_Message(Domain, IsOnline, sqlex.Message, System.Web.HttpContext.Current.Session("Choice")))
                rows.Add(row)
            Catch exp As Exception
                logger.Error("TrainingAPI - RCVP_Rq_Slip_For_ElecItem_Save_Data" + exp.Message)
                'chk errorpage rights
                row = New Dictionary(Of String, Object)()
                row.Add("status", "Error")
                row.Add("msg", exp.Message)
                rows.Add(row)
            End Try
        Catch exce As System.Threading.ThreadAbortException ''to handle when page is redirect to another page(abort exception)
            logger.Error("TrainingAPI - RCVP_Rq_Slip_For_ElecItem_Save_Data" + exce.Message)
            'LblError.Text = exce.Message
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", exce.Message)
            rows.Add(row)

        Catch expe As System.Data.OleDb.OleDbException
            logger.Error("TrainingAPI - RCVP_Rq_Slip_For_ElecItem_Save_Data" + expe.Message)
            'LblError.Text = expe.Message.ToString
            row = New Dictionary(Of String, Object)()
            row.Add("status", "Error")
            row.Add("msg", expe.Message.ToString)
            rows.Add(row)
        Catch ex As Exception
