    Public Function fillCalenderGridFinancialYear_New(ByVal Domain As String, ByVal isonline As String, ByVal Financialyear As String, ByVal periodtype As String, ByVal CourseDirId As String, ByVal CourseDirector As String, ByVal SponsorID As String, ByVal Procedure As String, ByVal sortby As String, ByVal TrainingStatusId As String, ByVal Searchcode As String, ByVal LANGUAGE As String, ByVal sponsortype As String, ByVal TrainingSearch As String, ByVal SponsorSearch As String, ByVal CourseDirectorSearch As String, ByVal Viewrights As String, ByVal APIKEY As String)
