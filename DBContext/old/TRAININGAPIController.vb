    Public Function GetFinancialYear_For_Reports() As DataTable
        Dim dtfinYear As New DataTable
        dtfinYear.Columns.Add("Sr", GetType(Integer))
        dtfinYear.Columns.Add("YearText")
        dtfinYear.Columns.Add("YearValue")
        Dim year As Integer = Now.Year
        Dim finyear As String
        Dim count As Integer = 1
        For index As Integer = -8 To 1

            finyear = year + index & "-" & year + index + 1
            dtfinYear.LoadDataRow(New Object() {count, finyear, finyear}, False)
            count = count + 1
        Next
        dtfinYear.DefaultView.Sort = "Sr desc"
        dtfinYear = dtfinYear.DefaultView.ToTable
        Return dtfinYear
    End Function

