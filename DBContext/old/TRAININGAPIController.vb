            If dm.ResetPassword(Domain, IsOnline, userid, Nothing, pvalue, type) = True Then

                row = New Dictionary(Of String, Object)()
                row.Add("status", "Success")
                rows.Add(row)

                '***********Code to send mail on password change
                Dim dtuser As DataTable
