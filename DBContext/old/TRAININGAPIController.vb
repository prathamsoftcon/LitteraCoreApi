            dt_Trg_From_Session_info = dt_Trg_From_Session_info.DefaultView.ToTable




            'Update sesionid and other information


            Dim trainingid As String = cloneto_trgid
            Dim timetableid As String = ""
            Dim sessionid As String = Guid.NewGuid().ToString

            Dim contentdesc As String = sessionsubject
            Dim duration As String = sessionduration
            Dim sessionrowno As String = "1"
            Dim status As String = "0"
            Dim sessionno As String = ""
            Dim Change_Remark As String = remark
            Dim sessiondate As String = sesiondate
            Dim sessionstarttime As String = sessiontime

            '*********Calculate Endtime

            Dim durationmin As String = ""
            If durationtype = "2" Then
                durationmin = CDbl(duration) * 60
            ElseIf durationtype = "3" Then
                durationmin = CDbl(duration) * 1440
            Else
                durationmin = duration
            End If


            Dim starttimewithdate As String = sesiondate + " " + sessionstarttime
            Dim enddatetwithtime As String = CDate(Convert.ToDateTime(sesiondate + " " + sessionstarttime).AddMinutes(durationmin)).ToString("yyyy/MM/dd HH:mm:ss")

            ' Dim sessionendtime As String = Convert.ToDateTime(enddatetwithtime).TimeOfDay.ToString


            Dim sessionday As String = ""
            Dim sessionweek As String = ""

            Dim facultyid As String = ""
            Dim subject As String = ""
            Dim sessiontype As String = ""
            Dim isjointsession As String = ""
            If dt_Trg_From_Session_info.Rows.Count > 0 Then
                dt_Trg_From_Session_info.DefaultView.Sort = "ttttt_is_joint_session desc"
